            }
          },
          {
            "currency": "USD",
            "income": {
              "amount": "0.00",
              "currency": "USD"
            },
            "expense": {
              "amount": "20.00",
              "currency": "USD"
            }
          }
        ],
        "consolidated": {
          "income": {
            "amount": "12000.00",
            "currency": "BOB"
          },
          "expense": {
            "amount": "8465.50",
            "currency": "BOB"
          },
          "savings": {
            "amount": "3534.50",
            "currency": "BOB"
          },
          "savingsRate": "29.5"
        },
        "balances": [
          {
            "accountId": "01928c4e-0000-7000-8000-0000000fc001",
            "balance": {
              "amount": "5185.00",
              "currency": "BOB"
            }
          }
        ],
        "netWorth": {
