        "snapshotId": "01928c4e-0000-7000-8000-0000000fb002",
        "previousSnapshotId": "01928c4e-0000-7000-8000-0000000fb001",
        "closedAt": "2026-11-03T15:00:00.000Z",
        "closedBy": "01928c4e-0000-7000-8000-0000000fd001",
        "baseCurrency": "BOB",
        "totalsByCurrency": [
          {
            "currency": "BOB",
            "income": {
              "amount": "12000.00",
