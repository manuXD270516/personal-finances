{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/planning/PeriodActivated.v1.schema.json",
  "title": "planning.PeriodActivated.v1",
  "description": "Un periodo financiero pasó de DRAFT a ACTIVE: automáticamente al llegar su fecha de inicio en la zona horaria del workspace (job planning.ensure-periods) o manualmente por un EDITOR/OWNER (openspec add-financial-periods). Productor: PLANNING. Consumidores: REPORTING (rótulo del periodo en curso; opcional), NOTIFY (pf-p2b, opcional \"empezó el mes\"). Idempotencia natural: (periodId, 'ACTIVATED') — un periodo se activa una sola vez en su vida. Los periodos creados ya iniciados nacen ACTIVE sin este evento. Sin PII.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "planning.PeriodActivated"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "FinancialPeriod"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "periodId",
        "label",
        "periodStart",
        "periodEnd",
        "startDay",
        "isTransition",
        "activatedAt",
        "activation"
      ],
      "properties": {
        "workspaceId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "periodId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "label": {
          "description": "Año y mes de la fecha de inicio (YYYY-MM, docs/33 D59).",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "periodStart": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "periodEnd": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "startDay": {
          "description": "Día de inicio del mes financiero con que se calculó el rango (1..28).",
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "isTransition": {
          "description": "Periodo de transición tras un cambio del día de inicio.",
          "type": "boolean"
        },
        "activatedAt": {
          "$ref": "../envelope.v1.schema.json#/$defs/Instant"
        },
        "activation": {
          "enum": [
            "AUTOMATIC",
            "MANUAL"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000201",
      "eventType": "planning.PeriodActivated",
      "eventVersion": 1,
      "occurredAt": "2026-11-01T04:05:00.000Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "FinancialPeriod",
      "aggregateId": "01928c4e-0000-7000-8000-0000000fa011",
      "aggregateVersion": 2,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c2",
      "causationId": null,
      "actor": {
        "type": "SYSTEM",
        "id": null
      },
      "payload": {
        "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
        "periodId": "01928c4e-0000-7000-8000-0000000fa011",
        "label": "2026-11",
        "periodStart": "2026-11-01",
        "periodEnd": "2026-11-30",
        "startDay": 1,
        "isTransition": false,
        "activatedAt": "2026-11-01T04:05:00.000Z",
        "activation": "AUTOMATIC"
      }
    }
  ]
}
