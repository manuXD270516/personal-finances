{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/transactions/TransactionCleared.v1.schema.json",
  "title": "transactions.TransactionCleared.v1",
  "description": "La transacción pasó de posted a cleared (confirmada contra el banco) o de cleared a posted, individualmente, en lote, dentro de una sesión de reconciliación o desde una edición masiva (docs/31 D47; openspec add-reconciliation). Se publica ADEMÁS de transactions.TransactionUpdated.v1 (que sigue llevando changedFields = [status]): es un hecho dedicado y aditivo que no cambia cifras. Sin montos ni texto libre. Productor: TRANSACTIONS. Consumidores: ninguno obligatorio. Idempotencia natural: (transactionId, aggregateVersion).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "transactions.TransactionCleared"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Transaction"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "accountId",
        "cleared",
        "status",
        "previousStatus",
        "revision",
        "reconciliationId",
        "bulkOperationId",
        "transition"
      ],
      "properties": {
        "transactionId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "accountId": {
          "description": "Cuenta principal de la transacción.",
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "cleared": {
          "description": "true ⇒ posted → cleared; false ⇒ cleared → posted.",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "POSTED",
            "CLEARED"
          ]
        },
        "previousStatus": {
          "enum": [
            "POSTED",
            "CLEARED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "reconciliationId": {
          "description": "Sesión de reconciliación en cuyo nombre se confirmó (null fuera de una sesión).",
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "bulkOperationId": {
          "description": "Correlación común de una confirmación en lote o en sesión (null en la individual).",
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "transition": {
          "description": "Transición de la máquina `Transaction` que originó el evento.",
          "enum": [
            "CLEAR",
            "UNCLEAR"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000150",
      "eventVersion": 1,
      "occurredAt": "2026-10-08T14:30:00.000Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "eventType": "transactions.TransactionCleared",
      "aggregateType": "Transaction",
      "aggregateId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
      "aggregateVersion": 2,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c5",
      "payload": {
        "transactionId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
        "accountId": "01928c4e-7a3b-7c11-8f00-0000000000a1",
        "cleared": true,
        "status": "CLEARED",
        "previousStatus": "POSTED",
        "revision": 1,
        "reconciliationId": null,
        "bulkOperationId": null,
        "transition": "CLEAR"
      }
    },
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000151",
      "eventVersion": 1,
      "occurredAt": "2026-10-08T14:30:00.000Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "eventType": "transactions.TransactionCleared",
      "aggregateType": "Transaction",
      "aggregateId": "01928c4e-7a3b-7c11-8f00-0000000000f2",
      "aggregateVersion": 3,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c6",
      "payload": {
        "transactionId": "01928c4e-7a3b-7c11-8f00-0000000000f2",
        "accountId": "01928c4e-7a3b-7c11-8f00-0000000000a1",
        "cleared": false,
        "status": "POSTED",
        "previousStatus": "CLEARED",
        "revision": 1,
        "reconciliationId": "01928c4e-7a3b-7c11-8f00-000000000a01",
        "bulkOperationId": "01928c4e-7a3b-7c11-8f00-0000000000b1",
        "transition": "UNCLEAR"
      }
    }
  ]
}
