{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/transactions/ConversionRevised.v1.schema.json",
  "title": "transactions.ConversionRevised.v1",
  "description": "Corrección financiera (montos, cuentas, fecha, tasa cotizada, referencia o fees) de una conversión posteada: transición REVISE de la máquina Transaction (reversa exacta del asiento activo + asiento nuevo + ConversionDetail con la revisión siguiente; docs/31 D48, simétrico a TransferRevised.v1). Lleva el detalle de la revisión nueva (misma forma que ConversionRecorded.v1) y los asientos revertido, de reversa y nuevo. ConversionRecorded.v1 NO se re-emite. Productor: TRANSACTIONS. Consumidores: REPORTING (Phase 1), FX (observación de tasa). Idempotencia natural: (transactionId, revisionTo). PII baja: provider.name.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "transactions.ConversionRevised"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Transaction"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "revisionFrom",
        "revisionTo",
        "businessDate",
        "executedAt",
        "source",
        "target",
        "quotedRate",
        "effectiveRate",
        "referenceRate",
        "fees",
        "spread",
        "provider",
        "convertedSource",
        "grossTarget",
        "quotedRateDeviation",
        "reversedJournalEntryId",
        "reversalJournalEntryId",
        "journalEntryId"
      ],
      "properties": {
        "transactionId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "revisionFrom": {
          "type": "integer",
          "minimum": 1
        },
        "revisionTo": {
          "type": "integer",
          "minimum": 2,
          "description": "revisionFrom + 1"
        },
        "businessDate": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "executedAt": {
          "$ref": "../envelope.v1.schema.json#/$defs/Instant"
        },
        "source": {
          "$ref": "#/$defs/Side"
        },
        "target": {
          "$ref": "#/$defs/Side"
        },
        "quotedRate": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveRate": {
          "$ref": "../envelope.v1.schema.json#/$defs/Rate"
        },
        "referenceRate": {
          "oneOf": [
            {
              "$ref": "#/$defs/ReferenceRate"
            },
            {
              "type": "null"
            }
          ]
        },
        "fees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fee"
          }
        },
        "spread": {
          "oneOf": [
            {
              "$ref": "#/$defs/Spread"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counterpartyId",
            "name"
          ],
          "properties": {
            "counterpartyId": {
              "oneOf": [
                {
                  "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          }
        },
        "convertedSource": {
          "$ref": "../envelope.v1.schema.json#/$defs/Money",
          "description": "Monto origen efectivamente convertido (bruto − fees en moneda origen) de la revisión revisionTo."
        },
        "grossTarget": {
          "$ref": "../envelope.v1.schema.json#/$defs/Money",
          "description": "Monto destino antes de fees en moneda destino de la revisión revisionTo."
        },
        "quotedRateDeviation": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bruto destino − convertido × tasa cotizada, si supera una unidad mínima."
        },
        "reversedJournalEntryId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid",
          "description": "Asiento de la revisión anterior (revertido)"
        },
        "reversalJournalEntryId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid",
          "description": "Reversa exacta del asiento revertido (INV-008)"
        },
        "journalEntryId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid",
          "description": "Asiento nuevo de la revisión revisionTo"
        }
      }
    },
    "Side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "amount"
      ],
      "properties": {
        "accountId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "amount": {
          "$ref": "../envelope.v1.schema.json#/$defs/PositiveMoney"
        }
      }
    },
    "Fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "amount",
        "paidFromAccountId"
      ],
      "properties": {
        "type": {
          "enum": [
            "PROVIDER",
            "NETWORK",
            "BANK",
            "TAX",
            "OTHER"
          ]
        },
        "amount": {
          "$ref": "../envelope.v1.schema.json#/$defs/PositiveMoney"
        },
        "paidFromAccountId": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReferenceRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate",
        "fxRateId",
        "source"
      ],
      "properties": {
        "rate": {
          "$ref": "../envelope.v1.schema.json#/$defs/Rate"
        },
        "fxRateId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "source": {
          "enum": [
            "MANUAL",
            "PROVIDER",
            "USER_CONVERSION"
          ]
        },
        "rateType": {
          "enum": [
            "OFFICIAL",
            "PARALLEL",
            "P2P",
            "BANK",
            "CUSTOM",
            "PARALLEL_BUY",
            "PARALLEL_SELL"
          ],
          "description": "FxRateType (opcional, cambio aditivo)."
        }
      }
    },
    "Spread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percentage",
        "amount"
      ],
      "properties": {
        "percentage": {
          "$ref": "../envelope.v1.schema.json#/$defs/Decimal"
        },
        "amount": {
          "$ref": "../envelope.v1.schema.json#/$defs/Money"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000202",
      "eventType": "transactions.ConversionRevised",
      "eventVersion": 1,
      "occurredAt": "2026-10-01T15:10:05.300Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "Transaction",
      "aggregateId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
      "aggregateVersion": 2,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c2",
      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "payload": {
        "transactionId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
        "revisionFrom": 1,
        "revisionTo": 2,
        "businessDate": "2026-10-01",
        "executedAt": "2026-10-01T13:58:00Z",
        "source": {
          "accountId": "01928c4e-0000-7000-8000-000000acc002",
          "amount": {
            "amount": "100.000000",
            "currency": "USDT"
          }
        },
        "target": {
          "accountId": "01928c4e-0000-7000-8000-000000acc001",
