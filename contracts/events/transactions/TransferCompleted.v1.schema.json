{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/transactions/TransferCompleted.v1.schema.json",
  "title": "transactions.TransferCompleted.v1",
  "description": "Transferencia entre cuentas del usuario en la misma moneda quedó posteada (creación, pending→posted o emparejamiento de dos transacciones importadas). Productor: TRANSACTIONS. Consumidores: GOALS, DEBT, REPORTING. Idempotencia natural: (transactionId, journalEntryId). Sin PII.",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "transactions.TransferCompleted"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Transaction"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "journalEntryId",
        "businessDate",
        "fromAccountId",
        "toAccountId",
        "amount",
        "fee",
        "matchedTransactionIds"
      ],
      "properties": {
        "transactionId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "journalEntryId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "businessDate": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "fromAccountId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "toAccountId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "amount": {
          "$ref": "../envelope.v1.schema.json#/$defs/PositiveMoney"
        },
        "fee": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/PositiveMoney"
            },
            {
              "type": "null"
            }
          ]
        },
        "matchedTransactionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
          }
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000002",
      "eventType": "transactions.TransferCompleted",
      "eventVersion": 1,
      "occurredAt": "2026-10-01T14:03:22.120Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "Transaction",
      "aggregateId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
      "aggregateVersion": 1,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c1",
      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "payload": {
        "transactionId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
        "journalEntryId": "01928c4e-7a3b-7c11-8f00-0000000000e1",
        "businessDate": "2026-10-01",
        "fromAccountId": "01928c4e-0000-7000-8000-000000acc001",
        "toAccountId": "01928c4e-0000-7000-8000-000000acc003",
        "amount": {
          "amount": "1000.00",
          "currency": "BOB"
        },
        "fee": null,
        "matchedTransactionIds": []
      }
    }
  ]
}
