{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/transactions/TransactionUpdated.v1.schema.json",
  "title": "transactions.TransactionUpdated.v1",
  "description": "La transacción cambió: edición descriptiva, cambio cleared/reconciled, des-reconciliación o amend financiero (en ese caso se emite junto a TransactionPosted, ledgerImpact = true). Sin montos ni texto libre salvo reason. Productor: TRANSACTIONS. Consumidores: REPORTING. Idempotencia natural: (transactionId, aggregateVersion). PII baja: reason. Campo opcional aditivo `transition` (openspec add-lifecycle-timeline, decisión 10): la transición de la máquina de estados que originó el evento; los consumidores existentes lo ignoran. `customFields` en changedFields (openspec add-custom-fields, aditivo): cambió el valor de algún custom field de algún split; los valores no viajan en el evento (INV-033: sin efecto en el ledger, ledgerImpact = false). `reconciliationMode` en changedFields (openspec add-reconciliation, aditivo): cambió el modo de conciliación (conciliación sin extracto, des-reconciliación o cotejo posterior por una sesión); `RECONCILE_WITHOUT_STATEMENT` es el marcado directo explícito (docs/33 D74). `CLEAR`/`UNCLEAR` publican además `transactions.TransactionCleared.v1` (docs/31 D47).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "transactions.TransactionUpdated"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Transaction"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "revision",
        "status",
        "previousStatus",
        "changedFields",
        "ledgerImpact",
        "reason"
      ],
      "properties": {
        "transactionId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "PENDING",
            "POSTED",
            "CLEARED",
            "RECONCILED"
          ]
        },
        "previousStatus": {
          "enum": [
            "PENDING",
            "POSTED",
            "CLEARED",
            "RECONCILED",
            null
          ]
        },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "description",
              "notes",
              "counterpartyId",
              "postingDate",
              "status",
              "amount",
              "businessDate",
              "accountId",
              "splits",
              "customFields",
              "reconciliationMode"
            ]
          }
        },
        "ledgerImpact": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "paymentMethod": {
          "description": "Medio de pago (D27, aditivo 2026-10-02)",
          "enum": [
            "CASH",
            "QR",
            "DEBIT_CARD",
            "CREDIT_CARD",
            "BANK_TRANSFER",
            "DIGITAL_WALLET",
            "OTHER",
            null
          ]
        },
        "transition": {
          "description": "Transición de la máquina `Transaction` que originó el evento (opcional, aditivo).",
          "type": "string",
          "enum": [
            "RECORD",
            "POST",
            "CLEAR",
            "UNCLEAR",
            "RECONCILE",
            "RECONCILE_WITHOUT_STATEMENT",
            "UNRECONCILE",
            "REVISE",
            "VOID"
          ]
        },
        "bulkOperationId": {
          "description": "Correlación común de una edición masiva (openspec add-bulk-edit; igual al correlation_id de los registros de auditoría y al de la operación). Ausente en las ediciones individuales. Aditivo (sin versión nueva).",
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000109",
      "eventType": "transactions.TransactionUpdated",
      "eventVersion": 1,
      "occurredAt": "2026-10-02T14:03:22.120Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "Transaction",
      "aggregateId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
      "aggregateVersion": 3,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c1",
      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "payload": {
        "transactionId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
        "revision": 1,
        "status": "CLEARED",
        "previousStatus": "RECONCILED",
        "changedFields": [
          "status"
        ],
        "ledgerImpact": false,
        "reason": "monto mal conciliado"
      }
    },
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000142",
      "eventType": "transactions.TransactionUpdated",
      "eventVersion": 1,
