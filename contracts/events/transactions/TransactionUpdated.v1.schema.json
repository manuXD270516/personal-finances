      "eventVersion": 1,
      "occurredAt": "2026-10-08T14:20:00.000Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "Transaction",
      "aggregateId": "01928c4e-7a3b-7c11-8f00-0000000000f2",
      "aggregateVersion": 4,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c4",
      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "payload": {
        "transactionId": "01928c4e-7a3b-7c11-8f00-0000000000f2",
        "revision": 1,
        "status": "RECONCILED",
        "previousStatus": "CLEARED",
        "changedFields": [
          "status",
