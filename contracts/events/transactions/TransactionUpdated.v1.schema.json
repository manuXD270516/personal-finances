      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "payload": {
        "transactionId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
        "revision": 2,
        "status": "POSTED",
        "previousStatus": null,
        "changedFields": [
          "customFields"
        ],
        "ledgerImpact": false,
        "reason": null
