{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/commitments/RecurringOccurrenceDue.v1.schema.json",
  "title": "commitments.RecurringOccurrenceDue.v1",
  "description": "La ocurrencia pasó a próxima (BECOME_DUE): hoy ≥ vencimiento − anticipación (zona horaria del workspace). Productor: COMMITMENTS. Consumidor: NOTIFY (notifications.occurrence-due; `add-subscriptions` filtra por `managedBy`). Idempotencia natural: occurrenceId. PII baja: `name`.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "commitments.RecurringOccurrenceDue"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "RecurringOccurrence"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "amount",
        "min",
        "max"
      ],
      "description": "Monto esperado según el tipo: FIXED/ESTIMATED llevan `amount`; MIN_MAX lleva `min` y `max`; VARIABLE ninguno. Texto decimal con la escala de la moneda.",
      "properties": {
        "type": {
          "enum": [
            "FIXED",
            "ESTIMATED",
            "MIN_MAX",
            "VARIABLE"
          ]
        },
        "amount": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/PositiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "min": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/PositiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/PositiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Kind": {
      "enum": [
        "INCOME",
        "EXPENSE",
        "TRANSFER"
      ]
    },
    "ManagedBy": {
      "enum": [
        "USER",
        "SUBSCRIPTION",
        "DEBT"
      ]
    },
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "occurrenceId",
        "definitionId",
        "name",
        "kind",
        "occurrenceDate",
        "dueDate",
        "expected",
        "currency",
        "requiresApproval",
        "mode",
        "managedBy",
        "periodId"
      ],
      "properties": {
        "workspaceId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "occurrenceId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "definitionId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "periodId": {
          "oneOf": [
            {
              "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "occurrenceDate": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "dueDate": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "expected": {
          "$ref": "#/$defs/Expected"
        },
        "currency": {
          "$ref": "../envelope.v1.schema.json#/$defs/CurrencyCode"
        },
        "requiresApproval": {
          "type": "boolean",
          "description": "true si el modo es PENDING_APPROVAL (bandeja \"por aprobar\")."
        },
        "mode": {
          "enum": [
            "AUTO_CREATE",
            "PENDING_APPROVAL",
            "NOTIFY_ONLY"
          ]
        },
        "managedBy": {
          "$ref": "#/$defs/ManagedBy"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000411",
      "eventType": "commitments.RecurringOccurrenceDue",
      "eventVersion": 1,
      "occurredAt": "2026-10-09T12:00:00.000Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "RecurringOccurrence",
      "aggregateId": "01928c4e-0000-7000-8000-0000000cc001",
      "aggregateVersion": 2,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c3",
      "causationId": null,
      "actor": {
        "type": "SYSTEM",
        "id": null
      },
      "payload": {
        "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
        "occurrenceId": "01928c4e-0000-7000-8000-0000000cc001",
        "definitionId": "01928c4e-0000-7000-8000-0000000de001",
        "name": "Internet",
        "kind": "EXPENSE",
        "occurrenceDate": "2026-10-20",
        "dueDate": "2026-10-20",
        "expected": {
          "type": "FIXED",
          "amount": "199.00",
          "min": null,
          "max": null
        },
        "currency": "BOB",
        "requiresApproval": true,
        "mode": "PENDING_APPROVAL",
        "managedBy": "USER",
        "periodId": "01928c4e-0000-7000-8000-0000000fa011"
      }
    }
  ]
}
