{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/fx/RateFeedRecovered.v1.schema.json",
  "title": "fx.RateFeedRecovered.v1",
  "description": "Un par con episodio de obsolescencia abierto recibió una tasa aceptada de un provider con antigüedad menor o igual a N horas: el episodio se cierra (D233). Un único hecho por episodio; un episodio cerrado porque el par se quitó o perdió su cobertura NO publica este hecho. Productor: FX (actor SYSTEM `fx-provider:<id del ciclo>`, correlationId = id del ciclo, aggregateType RateFeedEpisode, aggregateId = episodeId, aggregateVersion 2). Sin consumidores en Phase 5: NOTIFY recibe el aviso por su puerto síncrono (D249). Idempotencia natural: episodeId. Sin PII.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "fx.RateFeedRecovered"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "RateFeedEpisode"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeId",
        "base",
        "quote",
        "rateId",
        "asOf",
        "openedAt"
      ],
      "properties": {
        "episodeId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "base": {
          "$ref": "../envelope.v1.schema.json#/$defs/CurrencyCode"
        },
        "quote": {
          "$ref": "../envelope.v1.schema.json#/$defs/CurrencyCode"
        },
        "rateId": {
          "description": "Tasa aceptada que cerró el episodio.",
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "asOf": {
          "description": "Vigencia de la tasa que cerró el episodio.",
          "$ref": "../envelope.v1.schema.json#/$defs/Instant"
        },
        "openedAt": {
          "description": "Instante en que se abrió el episodio.",
          "$ref": "../envelope.v1.schema.json#/$defs/Instant"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000511",
      "eventType": "fx.RateFeedRecovered",
      "eventVersion": 1,
      "occurredAt": "2026-10-13T16:00:00.000Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "RateFeedEpisode",
      "aggregateId": "01928c4e-0000-7000-8000-0000000fe001",
      "aggregateVersion": 2,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000f2",
      "causationId": null,
      "actor": {
        "type": "SYSTEM",
        "id": "fx-provider:01928c4e-7a3b-7c11-8f00-0000000000f2"
      },
      "payload": {
        "episodeId": "01928c4e-0000-7000-8000-0000000fe001",
        "base": "USDT",
        "quote": "BOB",
        "rateId": "01928c4e-0000-7000-8000-0000000fa501",
        "asOf": "2026-10-13T15:58:00.000Z",
        "openedAt": "2026-10-13T14:15:00.000Z"
      }
    }
  ]
}
