{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/fx/RateAnomalyRetained.v1.schema.json",
  "title": "fx.RateAnomalyRetained.v1",
  "description": "Una muestra de provider se registró marcada como anómala en un workspace (variación mayor al umbral de su clase de activo: 5 % fiat y estables, 10 % cripto volátil, D228) y queda retenida, sin usarse para valorar, hasta que un miembro con permiso de edición la confirme o la rechace (sin aceptación automática, D236). Un único hecho por muestra retenida (D234); la carga histórica no marca anomalías y no lo publica. Productor: FX (actor SYSTEM `fx-provider:<id del ciclo>`, correlationId = id del ciclo, aggregateType ExchangeRate, aggregateId = rateId), en la misma unidad de trabajo que la inserción de la muestra y que `fx.RateRecorded.v1`. Sin consumidores en Phase 5: NOTIFY recibe el aviso por su puerto síncrono (D249). Idempotencia natural: rateId. variationPct es la variación con signo respecto de la línea base, a 4 decimales HALF_EVEN. Sin PII.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "fx.RateAnomalyRetained"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "ExchangeRate"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rateId",
        "base",
        "quote",
        "rateType",
        "provider",
        "value",
        "baselineRateId",
        "baselineValue",
        "variationPct",
        "thresholdPct"
      ],
      "properties": {
        "rateId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "base": {
          "$ref": "../envelope.v1.schema.json#/$defs/CurrencyCode"
        },
        "quote": {
          "$ref": "../envelope.v1.schema.json#/$defs/CurrencyCode"
        },
        "rateType": {
          "enum": [
            "OFFICIAL",
            "PARALLEL",
            "P2P",
            "BANK",
            "CUSTOM",
            "PARALLEL_BUY",
            "PARALLEL_SELL",
            "MARKET"
          ]
        },
        "provider": {
          "description": "Provider que publicó la muestra (los cripto usan el id `CRYPTO_<NOMBRE>`).",
          "oneOf": [
            {
              "enum": [
                "PARALELO_BO",
                "DOLARAPI_BO"
              ]
            },
            {
              "type": "string",
              "pattern": "^CRYPTO_[A-Z0-9_]{1,32}$"
            }
          ]
        },
        "value": {
          "$ref": "../envelope.v1.schema.json#/$defs/PositiveDecimal"
        },
        "baselineRateId": {
          "description": "Última tasa aceptada del mismo feed contra la que se midió la variación.",
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "baselineValue": {
          "$ref": "../envelope.v1.schema.json#/$defs/PositiveDecimal"
        },
        "variationPct": {
          "description": "(value − baselineValue) / baselineValue × 100, con signo, 4 decimales HALF_EVEN.",
          "$ref": "../envelope.v1.schema.json#/$defs/Decimal"
        },
        "thresholdPct": {
          "description": "Umbral vigente de la clase de activo del par.",
          "$ref": "../envelope.v1.schema.json#/$defs/PositiveDecimal"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000521",
      "eventType": "fx.RateAnomalyRetained",
      "eventVersion": 1,
      "occurredAt": "2026-10-13T14:15:00.200Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "ExchangeRate",
      "aggregateId": "01928c4e-0000-7000-8000-0000000fa501",
      "aggregateVersion": 1,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000f3",
      "causationId": null,
      "actor": {
        "type": "SYSTEM",
        "id": "fx-provider:01928c4e-7a3b-7c11-8f00-0000000000f3"
      },
      "payload": {
        "rateId": "01928c4e-0000-7000-8000-0000000fa501",
        "base": "BTC",
        "quote": "USDT",
        "rateType": "MARKET",
        "provider": "CRYPTO_EXAMPLE",
        "value": "72000.00",
        "baselineRateId": "01928c4e-0000-7000-8000-0000000fa500",
        "baselineValue": "65000.00",
        "variationPct": "10.7692",
        "thresholdPct": "10"
      }
    },
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000522",
      "eventType": "fx.RateAnomalyRetained",
      "eventVersion": 1,
      "occurredAt": "2026-10-13T14:15:00.300Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "ExchangeRate",
      "aggregateId": "01928c4e-0000-7000-8000-0000000fa503",
      "aggregateVersion": 1,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000f3",
      "causationId": null,
      "actor": {
        "type": "SYSTEM",
        "id": "fx-provider:01928c4e-7a3b-7c11-8f00-0000000000f3"
      },
      "payload": {
        "rateId": "01928c4e-0000-7000-8000-0000000fa503",
        "base": "USDT",
        "quote": "BOB",
        "rateType": "PARALLEL",
        "provider": "PARALELO_BO",
        "value": "11.40",
        "baselineRateId": "01928c4e-0000-7000-8000-0000000fa502",
        "baselineValue": "12.02",
        "variationPct": "-5.1581",
        "thresholdPct": "5"
      }
    }
  ]
}
