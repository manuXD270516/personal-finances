            "amount": {
              "amount": "685.00",
              "currency": "BOB"
            },
            "splitId": null
          },
          {
            "postingId": "01928c4e-0000-7000-8000-0000000b0005",
            "ledgerAccountId": "01928c4e-0000-7000-8000-0000000aa005",
            "accountId": null,
            "systemAccountCode": "EXPENSE:BOB",
            "amount": {
