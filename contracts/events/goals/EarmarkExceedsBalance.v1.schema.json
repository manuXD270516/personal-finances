{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/goals/EarmarkExceedsBalance.v1.schema.json",
  "title": "goals.EarmarkExceedsBalance.v1",
  "description": "Una cuenta quedó sobre-asignada: lo reservado por metas de ahorro (apartados más aportes reales que siguen en la cuenta) supera su saldo. Un hecho por episodio (se vuelve a emitir solo después de que la cuenta deje de estar sobre-asignada y vuelva a estarlo). `shortfall` = reserved − balance. Productor: GOALS (consumidor goals.balance-watch y job goals.daily-evaluation). Lo consume NOTIFY (GOAL_OVER_ALLOCATED). Idempotencia: (accountId, episodeId). El aggregateId del envelope es el id de la cuenta. Los nombres de la cuenta y de las metas son PII de baja sensibilidad (B).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "goals.EarmarkExceedsBalance"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Account"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "accountName",
        "episodeId",
        "balance",
        "reserved",
        "shortfall",
        "detectedOn",
        "goals"
      ],
      "properties": {
        "accountId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "accountName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "episodeId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "balance": {
          "$ref": "../envelope.v1.schema.json#/$defs/Money"
        },
        "reserved": {
          "$ref": "../envelope.v1.schema.json#/$defs/Money"
        },
        "shortfall": {
          "$ref": "../envelope.v1.schema.json#/$defs/PositiveMoney"
        },
        "detectedOn": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goalId",
              "goalName",
              "reserved"
            ],
            "properties": {
              "goalId": {
                "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
              },
              "goalName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "reserved": {
                "$ref": "../envelope.v1.schema.json#/$defs/Money"
              }
            }
          }
        }
      }
    }
  },
