{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/accounts/AccountClosed.v1.schema.json",
  "title": "accounts.AccountClosed.v1",
  "description": "Una cuenta fue cerrada (saldo cero); sigue visible pero no acepta nuevos movimientos (INV-026). Productor: ACCOUNTS. Consumidores: REPORTING, COMMITMENTS (Phase 3). Idempotencia natural: (accountId, aggregateVersion). PII baja: reason. Campo opcional aditivo `transition` (openspec add-lifecycle-timeline, decisión 10): la transición de la máquina de estados que originó el evento; los consumidores existentes lo ignoran.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "accounts.AccountClosed"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Account"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "closedOn",
        "reason"
      ],
      "properties": {
        "accountId": {
          "$ref": "../envelope.v1.schema.json#/$defs/Uuid"
        },
        "closedOn": {
          "$ref": "../envelope.v1.schema.json#/$defs/LocalDate"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "transition": {
          "description": "Transición de la máquina `Account` que originó el evento (opcional, aditivo).",
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSE",
            "ARCHIVE",
            "REACTIVATE"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000103",
      "eventType": "accounts.AccountClosed",
      "eventVersion": 1,
      "occurredAt": "2026-10-02T14:03:22.120Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "Account",
      "aggregateId": "01928c4e-0000-7000-8000-000000acc003",
      "aggregateVersion": 5,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000c1",
      "causationId": null,
      "actor": {
        "type": "USER",
        "id": "01928c4e-0000-7000-8000-00000000b001"
      },
      "payload": {
        "accountId": "01928c4e-0000-7000-8000-000000acc003",
        "closedOn": "2026-10-02",
        "reason": "Cuenta cerrada en el banco",
        "transition": "CLOSE"
      }
    }
  ]
}
