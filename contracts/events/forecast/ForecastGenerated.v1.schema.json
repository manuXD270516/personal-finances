{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/events/forecast/ForecastGenerated.v1.schema.json",
  "title": "forecast.ForecastGenerated.v1",
  "description": "Una corrida de pronóstico se completó: informa la corrida, el último periodo terminado que usó, la cantidad de series publicadas y con datos insuficientes y las versiones de los modelos, sin montos. Productor: FORECAST. Sin consumidores en Phase 8. Idempotencia: un hecho por corrida (aggregateId + aggregateVersion al completar).",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.v1.schema.json" }],
  "properties": {
    "eventType": { "const": "forecast.ForecastGenerated" },
    "eventVersion": { "const": 1 },
    "aggregateType": { "const": "ForecastRun" },
    "payload": { "$ref": "#/$defs/Payload" }
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecastRunId",
        "trigger",
        "asOfPeriod",
        "generatedAt",
        "reportingCurrency",
        "seriesPublished",
        "seriesInsufficient",
        "modelVersions"
      ],
      "properties": {
        "forecastRunId": { "$ref": "../envelope.v1.schema.json#/$defs/Uuid" },
        "trigger": { "enum": ["MANUAL", "SCHEDULED"] },
        "asOfPeriod": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "reportingCurrency": { "type": "string", "pattern": "^[A-Z0-9]{2,16}$" },
        "seriesPublished": { "type": "integer", "minimum": 0 },
        "seriesInsufficient": { "type": "integer", "minimum": 0 },
        "modelVersions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "examples": [
    {
      "eventId": "01928c4e-7a3b-7c11-8f00-000000000f01",
      "eventType": "forecast.ForecastGenerated",
      "eventVersion": 1,
      "occurredAt": "2026-11-01T05:15:30.000Z",
      "workspaceId": "01928c4e-0000-7000-8000-00000000a001",
      "aggregateType": "ForecastRun",
      "aggregateId": "01928c4e-0000-7000-8000-0000000f0001",
      "aggregateVersion": 3,
      "correlationId": "01928c4e-7a3b-7c11-8f00-0000000000f1",
      "causationId": null,
      "actor": { "type": "SYSTEM", "id": "forecasting.runner" },
      "payload": {
        "forecastRunId": "01928c4e-0000-7000-8000-0000000f0001",
        "trigger": "SCHEDULED",
        "asOfPeriod": "2026-10",
        "generatedAt": "2026-11-01T05:15:30.000Z",
        "reportingCurrency": "BOB",
        "seriesPublished": 18,
        "seriesInsufficient": 4,
        "modelVersions": ["mean_last_n@1"]
      }
    }
  ]
}
