{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/subscriptions.schema.json",
  "title": "pfos-export v1 — subscriptions",
  "description": "Registro de la sección «subscriptions» (tabla commitments.subscription, contexto commitments). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "definition_id",
    "counterparty_id",
    "name",
    "plan_name",
    "price_currency",
    "status",
    "trial_ends_on",
    "scheduled_cancellation_on",
    "cancelled_on",
    "cancellation_reason",
    "cancellation_url",
    "reminders_enabled",
    "reminder_days",
    "price_tolerance_percent",
    "next_renewal_on",
    "version",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "definition_id": {
      "type": "string",
      "format": "uuid"
    },
    "counterparty_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "plan_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "price_currency": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "trial_ends_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "scheduled_cancellation_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "cancelled_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "cancellation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancellation_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "reminders_enabled": {
      "type": "boolean"
    },
    "reminder_days": {
      "type": "integer"
    },
    "price_tolerance_percent": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "next_renewal_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "x-pfos-table": "commitments.subscription",
  "x-pfos-context": "commitments"
}
