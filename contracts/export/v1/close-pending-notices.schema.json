{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/close-pending-notices.schema.json",
  "title": "pfos-export v1 — close-pending-notices",
  "description": "Registro de la sección «close-pending-notices» (tabla planning.close_pending_notice, contexto planning). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "period_id",
    "published_at",
    "event_id"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "period_id": {
      "type": "string",
      "format": "uuid"
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "x-pfos-table": "planning.close_pending_notice",
  "x-pfos-context": "planning"
}
