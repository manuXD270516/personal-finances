{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/custom-field-definitions.schema.json",
  "title": "pfos-export v1 — custom-field-definitions",
  "description": "Registro de la sección «custom-field-definitions» (tabla classification.custom_field_definition, contexto classification). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "key",
    "label",
    "data_type",
    "target",
    "required",
    "options",
    "position",
    "archived_at",
    "archived_by",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "data_type": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "options": {
      "description": "JSON libre (no nulo).",
      "not": {
        "type": "null"
      }
    },
    "position": {
      "type": "integer"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "archived_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "classification.custom_field_definition",
  "x-pfos-context": "classification"
}
