{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/period-locks.schema.json",
  "title": "pfos-export v1 — period-locks",
  "description": "Registro de la sección «period-locks» (tabla ledger.period_lock, contexto ledger). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "year_month",
    "period_id",
    "locked_at",
    "locked_by",
    "period_start",
    "period_end"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "year_month": {
      "type": "string"
    },
    "period_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "locked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "locked_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "period_start": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "period_end": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    }
  },
  "x-pfos-table": "ledger.period_lock",
  "x-pfos-context": "ledger"
}
