{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/reconciliation-items.schema.json",
  "title": "pfos-export v1 — reconciliation-items",
  "description": "Registro de la sección «reconciliation-items» (tabla txn.reconciliation_item, contexto transactions). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "reconciliation_id",
    "transaction_id",
    "reconciled_at",
    "verified_without_statement",
    "unreconciled_at",
    "unreconciled_by",
    "unreconcile_reason"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "reconciliation_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "reconciled_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "verified_without_statement": {
      "type": "boolean"
    },
    "unreconciled_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "unreconciled_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "unreconcile_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-pfos-table": "txn.reconciliation_item",
  "x-pfos-context": "transactions"
}
