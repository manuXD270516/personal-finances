{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/transaction-journal-links.schema.json",
  "title": "pfos-export v1 — transaction-journal-links",
  "description": "Registro de la sección «transaction-journal-links» (tabla txn.transaction_journal_link, contexto transactions). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "transaction_id",
    "revision",
    "journal_entry_id",
    "link_type",
    "created_at"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer"
    },
    "journal_entry_id": {
      "type": "string",
      "format": "uuid"
    },
    "link_type": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "txn.transaction_journal_link",
  "x-pfos-context": "transactions"
}
