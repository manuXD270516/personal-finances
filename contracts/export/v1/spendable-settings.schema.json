{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/spendable-settings.schema.json",
  "title": "pfos-export v1 — spendable-settings",
  "description": "Registro de la sección «spendable-settings» (tabla reporting.spendable_setting, contexto reporting). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "horizon_mode",
    "subtract_essentials",
    "version",
    "updated_at"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "horizon_mode": {
      "type": "string"
    },
    "subtract_essentials": {
      "type": "boolean"
    },
    "version": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "reporting.spendable_setting",
  "x-pfos-context": "reporting"
}
