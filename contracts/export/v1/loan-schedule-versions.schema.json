{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/loan-schedule-versions.schema.json",
  "title": "pfos-export v1 — loan-schedule-versions",
  "description": "Registro de la sección «loan-schedule-versions» (tabla debt.loan_schedule_version, contexto debt). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "loan_id",
    "workspace_id",
    "schedule_version",
    "reason",
    "effective_from",
    "parameters",
    "created_at",
    "created_by"
  ],
  "properties": {
    "loan_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "schedule_version": {
      "type": "integer"
    },
    "reason": {
      "type": "string"
    },
    "effective_from": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "parameters": {
      "description": "JSON libre (no nulo).",
      "not": {
        "type": "null"
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    }
  },
  "x-pfos-table": "debt.loan_schedule_version",
  "x-pfos-context": "debt"
}
