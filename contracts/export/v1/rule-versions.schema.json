{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/rule-versions.schema.json",
  "title": "pfos-export v1 — rule-versions",
  "description": "Registro de la sección «rule-versions» (tabla rules.rule_version, contexto rules). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "rule_id",
    "version",
    "snapshot",
    "created_at",
    "created_by"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "rule_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer"
    },
    "snapshot": {
      "description": "JSON libre (no nulo).",
      "not": {
        "type": "null"
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    }
  },
  "x-pfos-table": "rules.rule_version",
  "x-pfos-context": "rules"
}
