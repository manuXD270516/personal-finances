{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/budgets.schema.json",
  "title": "pfos-export v1 — budgets",
  "description": "Registro de la sección «budgets» (tabla planning.budget, contexto planning). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "period_id",
    "currency",
    "origin",
    "template_version_id",
    "cloned_from_budget_id",
    "zero_based",
    "version",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "period_id": {
      "type": "string",
      "format": "uuid"
    },
    "currency": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "template_version_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "cloned_from_budget_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "zero_based": {
      "type": "boolean"
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "x-pfos-table": "planning.budget",
  "x-pfos-context": "planning"
}
