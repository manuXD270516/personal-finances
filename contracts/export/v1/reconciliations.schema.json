{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/reconciliations.schema.json",
  "title": "pfos-export v1 — reconciliations",
  "description": "Registro de la sección «reconciliations» (tabla txn.reconciliation, contexto transactions). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "account_id",
    "currency",
    "statement_date",
    "statement_balance",
    "cleared_balance",
    "difference",
    "status",
    "adjustment_transaction_id",
    "statement_document_id",
    "started_by",
    "started_at",
    "completed_by",
    "completed_at",
    "cancelled_by",
    "cancelled_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "currency": {
      "type": "string"
    },
    "statement_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "statement_balance": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "cleared_balance": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "difference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "status": {
      "type": "string"
    },
    "adjustment_transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "statement_document_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "started_by": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "completed_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "cancelled_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "cancelled_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "version": {
      "type": "integer"
    }
  },
  "x-pfos-table": "txn.reconciliation",
  "x-pfos-context": "transactions"
}
