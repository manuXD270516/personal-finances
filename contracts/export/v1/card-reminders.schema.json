{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/card-reminders.schema.json",
  "title": "pfos-export v1 — card-reminders",
  "description": "Registro de la sección «card-reminders» (tabla debt.card_reminder, contexto debt). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "card_account_id",
    "closing_date",
    "due_date",
    "emitted_at",
    "event_id"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "card_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "closing_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "due_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "emitted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "x-pfos-table": "debt.card_reminder",
  "x-pfos-context": "debt"
}
