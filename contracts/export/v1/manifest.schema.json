{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/manifest.schema.json",
  "title": "pfos-export v1 — manifest.json",
  "description": "Manifiesto del archivo de exportación del workspace (openspec add-workspace-export). Índice con la suma SHA-256 de cada archivo, los conteos por sección y la verificación (saldos por cuenta y balance de comprobación de la instantánea) que la importación reproduce antes de hacer visible el workspace nuevo. Los campos desconocidos se ignoran (versiones menores compatibles).",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "workspaceId",
    "workspaceName",
    "isDemo",
    "exportedAt",
    "snapshotAt",
    "pfosVersion",
    "baseCurrency",
    "timezone",
    "sections",
    "csv",
    "verification",
    "actors"
  ],
  "properties": {
    "format": { "const": "pfos-export" },
    "formatVersion": { "type": "integer", "minimum": 1, "description": "Versión del formato; 1 es la única soportada hoy." },
    "workspaceId": { "type": "string", "format": "uuid" },
    "workspaceName": { "type": "string", "minLength": 1 },
    "isDemo": {
      "type": "boolean",
      "description": "El export de un workspace de demostración NUNCA se importa (EXPORT_FORMAT_UNSUPPORTED)."
    },
    "exportedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "snapshotAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "Instante de la instantánea REPEATABLE READ."
    },
    "pfosVersion": { "type": "string" },
    "baseCurrency": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
    "timezone": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file", "schema", "count", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "file": { "type": "string", "pattern": "^json/[a-z][a-z0-9-]{0,62}\\.jsonl$" },
          "schema": { "type": "string", "format": "uri" },
          "count": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "csv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file", "count", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "file": { "type": "string", "pattern": "^csv/[a-z][a-z0-9-]{0,62}\\.csv$" },
          "count": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["accountBalances", "trialBalance"],
      "properties": {
        "accountBalances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["accountId", "currency", "balance"],
            "properties": {
              "accountId": { "type": "string", "format": "uuid" },
              "currency": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
              "balance": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$", "description": "Suma de los postings de la cuenta, con la escala de su moneda." }
            }
          }
        },
        "trialBalance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ledgerAccountId", "currency", "balance"],
            "properties": {
              "ledgerAccountId": { "type": "string", "format": "uuid" },
              "currency": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
              "balance": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$", "description": "Σ de la cuenta contable por moneda; el balance de comprobación suma 0 por moneda." }
            }
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "description": "Miembros del workspace: resuelven los ids de usuario que aparecen como autores (los usuarios no viajan).",
      "items": {
        "type": "object",
        "required": ["userId", "displayName"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "displayName": { "type": "string" }
        }
      }
    }
  }
}
