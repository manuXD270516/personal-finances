{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/budget-lines.schema.json",
  "title": "pfos-export v1 — budget-lines",
  "description": "Registro de la sección «budget-lines» (tabla planning.budget_line, contexto planning). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "budget_id",
    "target_kind",
    "target_id",
    "nature",
    "kind",
    "planned_amount",
    "min_amount",
    "max_amount",
    "percent",
    "income_basis",
    "rollover_policy",
    "rollover_cap",
    "rollover_in_amount",
    "rollover_status",
    "thresholds",
    "source",
    "template_line_id",
    "overridden",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "budget_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_kind": {
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "nature": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "planned_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "min_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "max_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "percent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "income_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollover_policy": {
      "type": "string"
    },
    "rollover_cap": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "rollover_in_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "rollover_status": {
      "type": "string"
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      }
    },
    "source": {
      "type": "string"
    },
    "template_line_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "overridden": {
      "type": "boolean"
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "planning.budget_line",
  "x-pfos-context": "planning"
}
