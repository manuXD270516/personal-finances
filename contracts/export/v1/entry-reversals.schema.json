{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/entry-reversals.schema.json",
  "title": "pfos-export v1 — entry-reversals",
  "description": "Registro de la sección «entry-reversals» (tabla ledger.entry_reversal, contexto ledger). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "original_entry_id",
    "reversal_entry_id",
    "workspace_id",
    "created_at"
  ],
  "properties": {
    "original_entry_id": {
      "type": "string",
      "format": "uuid"
    },
    "reversal_entry_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "ledger.entry_reversal",
  "x-pfos-context": "ledger"
}
