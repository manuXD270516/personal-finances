{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/close-snapshot-without-statement.schema.json",
  "title": "pfos-export v1 — close-snapshot-without-statement",
  "description": "Registro de la sección «close-snapshot-without-statement» (tabla planning.close_snapshot_without_statement, contexto planning). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "transaction_id",
    "workspace_id",
    "account_id",
    "business_date",
    "amount",
    "scale",
    "currency"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "business_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "scale": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    }
  },
  "x-pfos-table": "planning.close_snapshot_without_statement",
  "x-pfos-context": "planning"
}
