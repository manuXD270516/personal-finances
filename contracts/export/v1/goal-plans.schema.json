{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/goal-plans.schema.json",
  "title": "pfos-export v1 — goal-plans",
  "description": "Registro de la sección «goal-plans» (tabla goals.goal_plan, contexto goals). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "workspace_id",
    "monthly_amount",
    "currency",
    "fund",
    "source_account_id",
    "destination_account_id",
    "day_of_month",
    "automation",
    "materialization_mode",
    "auto_create_status",
    "definition_id",
    "version",
    "updated_at"
  ],
  "properties": {
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "monthly_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "fund": {
      "type": "string"
    },
    "source_account_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "destination_account_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "day_of_month": {
      "type": [
        "integer",
        "null"
      ]
    },
    "automation": {
      "type": "string"
    },
    "materialization_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "auto_create_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "definition_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "version": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "goals.goal_plan",
  "x-pfos-context": "goals"
}
