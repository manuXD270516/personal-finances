{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/card-charges.schema.json",
  "title": "pfos-export v1 — card-charges",
  "description": "Registro de la sección «card-charges» (tabla debt.card_charge, contexto debt). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "card_id",
    "card_account_id",
    "account_id",
    "transaction_id",
    "business_date",
    "currency",
    "interest",
    "fees",
    "insurance",
    "taxes",
    "origin",
    "status",
    "void_reason",
    "created_at",
    "created_by",
    "voided_at",
    "voided_by",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "card_id": {
      "type": "string",
      "format": "uuid"
    },
    "card_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "business_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "currency": {
      "type": "string"
    },
    "interest": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "fees": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "insurance": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "taxes": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "origin": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "void_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "voided_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "voided_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "version": {
      "type": "integer"
    }
  },
  "x-pfos-table": "debt.card_charge",
  "x-pfos-context": "debt"
}
