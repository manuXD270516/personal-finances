{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/close-snapshot-balances.schema.json",
  "title": "pfos-export v1 — close-snapshot-balances",
  "description": "Registro de la sección «close-snapshot-balances» (tabla planning.close_snapshot_balance, contexto planning). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "account_id",
    "workspace_id",
    "ledger_account_id",
    "account_name",
    "currency",
    "scale",
    "balance",
    "presented",
    "reconciliation_id",
    "statement_date",
    "statement_balance",
    "reconciliation_basis"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "ledger_account_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "account_name": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "scale": {
      "type": "integer"
    },
    "balance": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "presented": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "reconciliation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "statement_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "statement_balance": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "reconciliation_basis": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-pfos-table": "planning.close_snapshot_balance",
  "x-pfos-context": "planning"
}
