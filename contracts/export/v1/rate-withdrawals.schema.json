{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/rate-withdrawals.schema.json",
  "title": "pfos-export v1 — rate-withdrawals",
  "description": "Registro de la sección «rate-withdrawals» (tabla fx.rate_withdrawal, contexto fx). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange_rate_id",
    "workspace_id",
    "transaction_id",
    "reason",
    "withdrawn_at"
  ],
  "properties": {
    "exchange_rate_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    },
    "withdrawn_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "fx.rate_withdrawal",
  "x-pfos-context": "fx"
}
