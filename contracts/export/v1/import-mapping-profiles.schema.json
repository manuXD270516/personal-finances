{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/import-mapping-profiles.schema.json",
  "title": "pfos-export v1 — import-mapping-profiles",
  "description": "Registro de la sección «import-mapping-profiles» (tabla imports.mapping_profile, contexto imports). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "workspace_id",
    "institution_id",
    "account_id",
    "name",
    "format",
    "options",
    "options_schema_version",
    "archived_at",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "institution_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "options": {
      "description": "JSON libre (no nulo).",
      "not": {
        "type": "null"
      }
    },
    "options_schema_version": {
      "type": "integer"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "imports.mapping_profile",
  "x-pfos-context": "imports"
}
