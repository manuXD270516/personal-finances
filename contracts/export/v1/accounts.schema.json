{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/accounts.schema.json",
  "title": "pfos-export v1 — accounts",
  "description": "Registro de la sección «accounts» (tabla accounts.account, contexto accounts). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "name",
    "type",
    "classification",
    "currency",
    "institution_id",
    "liquidity",
    "include_in_net_worth",
    "include_in_budget",
    "opened_on",
    "closed_on",
    "close_reason",
    "archived_at",
    "archive_reason",
    "display_order",
    "account_number_last4",
    "color",
    "icon",
    "notes",
    "crypto_network",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "institution_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "liquidity": {
      "type": "string"
    },
    "include_in_net_worth": {
      "type": "boolean"
    },
    "include_in_budget": {
      "type": "boolean"
    },
    "opened_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "closed_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "close_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "archive_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_order": {
      "type": "integer"
    },
    "account_number_last4": {
      "type": [
        "string",
        "null"
      ]
    },
    "color": {
      "type": [
        "string",
        "null"
      ]
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "crypto_network": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "accounts.account",
  "x-pfos-context": "accounts"
}
