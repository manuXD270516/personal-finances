{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/card-utilization-states.schema.json",
  "title": "pfos-export v1 — card-utilization-states",
  "description": "Registro de la sección «card-utilization-states» (tabla debt.card_utilization_state, contexto debt). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "card_id",
    "scope_key",
    "threshold",
    "armed",
    "crossing_no",
    "updated_at"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "card_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope_key": {
      "type": "string"
    },
    "threshold": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "armed": {
      "type": "boolean"
    },
    "crossing_no": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "debt.card_utilization_state",
  "x-pfos-context": "debt"
}
