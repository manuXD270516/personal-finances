{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/transactions.schema.json",
  "title": "pfos-export v1 — transactions",
  "description": "Registro de la sección «transactions» (tabla txn.transaction, contexto transactions). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "kind",
    "status",
    "transaction_date",
    "posting_date",
    "account_id",
    "amount",
    "currency",
    "adjustment_direction",
    "description",
    "notes",
    "counterparty_id",
    "payment_method",
    "source",
    "external_ref_namespace",
    "external_ref_id",
    "refund_of_transaction_id",
    "adjustment_reason",
    "confirmed_refund_excess",
    "revision",
    "active_entry_id",
    "voided_at",
    "void_reason",
    "search_text",
    "version",
    "created_at",
    "updated_at",
    "reconciliation_id",
    "reconciliation_mode",
    "import_job_id",
    "loan_payment_breakdown"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "transaction_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "posting_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "adjustment_direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterparty_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payment_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "external_ref_namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_ref_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "refund_of_transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "adjustment_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_refund_excess": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer"
    },
    "active_entry_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "voided_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "void_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "search_text": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "reconciliation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "reconciliation_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "import_job_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "loan_payment_breakdown": {}
  },
  "x-pfos-table": "txn.transaction",
  "x-pfos-context": "transactions"
}
