{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/account-custom-field-values.schema.json",
  "title": "pfos-export v1 — account-custom-field-values",
  "description": "Registro de la sección «account-custom-field-values» (tabla accounts.account_custom_field_value, contexto accounts). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "account_id",
    "field_id",
    "value_text",
    "value_number",
    "value_date",
    "value_bool"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "field_id": {
      "type": "string",
      "format": "uuid"
    },
    "value_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "value_number": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "value_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "value_bool": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "x-pfos-table": "accounts.account_custom_field_value",
  "x-pfos-context": "accounts"
}
