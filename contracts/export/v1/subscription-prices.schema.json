{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/subscription-prices.schema.json",
  "title": "pfos-export v1 — subscription-prices",
  "description": "Registro de la sección «subscription-prices» (tabla commitments.subscription_price, contexto commitments). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "subscription_id",
    "effective_from",
    "amount",
    "currency",
    "origin",
    "supersedes_id",
    "proposal_id",
    "recorded_at",
    "recorded_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "subscription_id": {
      "type": "string",
      "format": "uuid"
    },
    "effective_from": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "proposal_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "recorded_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "x-pfos-table": "commitments.subscription_price",
  "x-pfos-context": "commitments"
}
