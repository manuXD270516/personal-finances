{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/subscription-charges.schema.json",
  "title": "pfos-export v1 — subscription-charges",
  "description": "Registro de la sección «subscription-charges» (tabla commitments.subscription_charge, contexto commitments). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "subscription_id",
    "occurrence_id",
    "occurrence_date",
    "transaction_id",
    "charged_amount",
    "charged_currency",
    "price_currency_amount",
    "expected_amount",
    "expected_currency",
    "implied_rate",
    "deviation_percent",
    "outcome",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "subscription_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurrence_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurrence_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "charged_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "charged_currency": {
      "type": "string"
    },
    "price_currency_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "expected_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "expected_currency": {
      "type": "string"
    },
    "implied_rate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "deviation_percent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "outcome": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "commitments.subscription_charge",
  "x-pfos-context": "commitments"
}
