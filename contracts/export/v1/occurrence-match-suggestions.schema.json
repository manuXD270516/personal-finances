{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/occurrence-match-suggestions.schema.json",
  "title": "pfos-export v1 — occurrence-match-suggestions",
  "description": "Registro de la sección «occurrence-match-suggestions» (tabla commitments.occurrence_match_suggestion, contexto commitments). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "occurrence_id",
    "definition_id",
    "transaction_id",
    "score",
    "confidence",
    "amount_delta",
    "currency",
    "date_delta_days",
    "counterparty_match",
    "ambiguous",
    "status",
    "expire_reason",
    "source_event_id",
    "created_at",
    "decided_at",
    "decided_by",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurrence_id": {
      "type": "string",
      "format": "uuid"
    },
    "definition_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "score": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "confidence": {
      "type": "string"
    },
    "amount_delta": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "date_delta_days": {
      "type": "integer"
    },
    "counterparty_match": {
      "type": "string"
    },
    "ambiguous": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "expire_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "version": {
      "type": "integer"
    }
  },
  "x-pfos-table": "commitments.occurrence_match_suggestion",
  "x-pfos-context": "commitments"
}
