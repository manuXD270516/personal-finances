{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/ledger-accounts.schema.json",
  "title": "pfos-export v1 — ledger-accounts",
  "description": "Registro de la sección «ledger-accounts» (tabla ledger.ledger_account, contexto ledger). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "type",
    "currency",
    "system_kind",
    "source_account_id",
    "code",
    "created_at",
    "archived_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "system_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_account_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "code": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "ledger.ledger_account",
  "x-pfos-context": "ledger"
}
