{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/notification-preferences.schema.json",
  "title": "pfos-export v1 — notification-preferences",
  "description": "Registro de la sección «notification-preferences» (tabla notifications.notification_preference, contexto notifications). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "user_id",
    "notification_type",
    "channel",
    "enabled",
    "version",
    "updated_at"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "notification_type": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "version": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "notifications.notification_preference",
  "x-pfos-context": "notifications"
}
