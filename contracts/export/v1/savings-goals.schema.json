{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/savings-goals.schema.json",
  "title": "pfos-export v1 — savings-goals",
  "description": "Registro de la sección «savings-goals» (tabla goals.savings_goal, contexto goals). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "name",
    "goal_type",
    "target_amount",
    "currency",
    "start_date",
    "target_date",
    "priority",
    "icon",
    "color",
    "notes",
    "tolerance_percent",
    "pace_periods",
    "status",
    "achieved_on",
    "closed_on",
    "cancelled_on",
    "cancel_reason",
    "archived_at",
    "version",
    "created_by",
    "created_at",
    "updated_by",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "goal_type": {
      "type": "string"
    },
    "target_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "target_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "priority": {
      "type": "integer"
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "color": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tolerance_percent": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "pace_periods": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "achieved_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "closed_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "cancelled_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "cancel_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "version": {
      "type": "integer"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_by": {
      "type": "string",
      "format": "uuid"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "goals.savings_goal",
  "x-pfos-context": "goals"
}
