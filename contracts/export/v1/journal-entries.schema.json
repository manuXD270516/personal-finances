{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/journal-entries.schema.json",
  "title": "pfos-export v1 — journal-entries",
  "description": "Registro de la sección «journal-entries» (tabla ledger.journal_entry, contexto ledger). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "sequence",
    "entry_date",
    "entry_type",
    "source_context",
    "source_type",
    "source_id",
    "source_revision",
    "reverses_entry_id",
    "memo",
    "correlation_id",
    "created_at",
    "created_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "entry_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "entry_type": {
      "type": "string"
    },
    "source_context": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_revision": {
      "type": "integer"
    },
    "reverses_entry_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "memo": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "x-pfos-table": "ledger.journal_entry",
  "x-pfos-context": "ledger"
}
