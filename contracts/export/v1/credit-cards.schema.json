{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/credit-cards.schema.json",
  "title": "pfos-export v1 — credit-cards",
  "description": "Registro de la sección «credit-cards» (tabla debt.credit_card, contexto debt). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "name",
    "limit_mode",
    "shared_limit_amount",
    "shared_limit_currency",
    "annual_rate",
    "utilization_thresholds",
    "reminder_days",
    "status",
    "archived_at",
    "version",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "limit_mode": {
      "type": "string"
    },
    "shared_limit_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "shared_limit_currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "annual_rate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "utilization_thresholds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      }
    },
    "reminder_days": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "version": {
      "type": "integer"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "debt.credit_card",
  "x-pfos-context": "debt"
}
