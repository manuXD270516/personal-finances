{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/goal-account-reservation-states.schema.json",
  "title": "pfos-export v1 — goal-account-reservation-states",
  "description": "Registro de la sección «goal-account-reservation-states» (tabla goals.account_reservation_state, contexto goals). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "account_id",
    "state",
    "episode_id",
    "since",
    "shortfall",
    "currency",
    "evaluated_at",
    "version"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string"
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "since": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "shortfall": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluated_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "version": {
      "type": "integer"
    }
  },
  "x-pfos-table": "goals.account_reservation_state",
  "x-pfos-context": "goals"
}
