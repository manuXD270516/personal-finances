{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/conversion-details.schema.json",
  "title": "pfos-export v1 — conversion-details",
  "description": "Registro de la sección «conversion-details» (tabla txn.conversion_detail, contexto transactions). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "revision",
    "workspace_id",
    "source_account_id",
    "target_account_id",
    "source_amount",
    "source_currency",
    "converted_source_amount",
    "gross_target_amount",
    "target_amount",
    "target_currency",
    "quoted_base",
    "quoted_quote",
    "quoted_rate",
    "effective_base",
    "effective_quote",
    "effective_rate",
    "reference_exchange_rate_id",
    "reference_base",
    "reference_quote",
    "reference_rate",
    "reference_source",
    "reference_rate_type",
    "reference_as_of",
    "spread_pct",
    "spread_amount",
    "spread_currency",
    "quoted_rate_deviation",
    "provider_counterparty_id",
    "provider_name",
    "external_ref",
    "executed_at",
    "created_at"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "source_currency": {
      "type": "string"
    },
    "converted_source_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "gross_target_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "target_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "target_currency": {
      "type": "string"
    },
    "quoted_base": {
      "type": [
        "string",
        "null"
      ]
    },
    "quoted_quote": {
      "type": [
        "string",
        "null"
      ]
    },
    "quoted_rate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "effective_base": {
      "type": "string"
    },
    "effective_quote": {
      "type": "string"
    },
    "effective_rate": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "reference_exchange_rate_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "reference_base": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_quote": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_rate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "reference_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_rate_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_as_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "spread_pct": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "spread_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "spread_currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "quoted_rate_deviation": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "provider_counterparty_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "provider_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "executed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "txn.conversion_detail",
  "x-pfos-context": "transactions"
}
