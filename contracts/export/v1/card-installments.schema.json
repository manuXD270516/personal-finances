{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/card-installments.schema.json",
  "title": "pfos-export v1 — card-installments",
  "description": "Registro de la sección «card-installments» (tabla debt.card_installment, contexto debt). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "plan_id",
    "n",
    "billing_closing_date",
    "due_date",
    "nominal_due_date",
    "principal",
    "interest",
    "total"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "n": {
      "type": "integer"
    },
    "billing_closing_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "due_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "nominal_due_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "principal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "interest": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "total": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  },
  "x-pfos-table": "debt.card_installment",
  "x-pfos-context": "debt"
}
