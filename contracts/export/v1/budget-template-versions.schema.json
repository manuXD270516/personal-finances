{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/budget-template-versions.schema.json",
  "title": "pfos-export v1 — budget-template-versions",
  "description": "Registro de la sección «budget-template-versions» (tabla planning.budget_template_version, contexto planning). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "template_id",
    "version_no",
    "based_on_version_no",
    "change_note",
    "created_at",
    "created_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "template_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_no": {
      "type": "integer"
    },
    "based_on_version_no": {
      "type": [
        "integer",
        "null"
      ]
    },
    "change_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "x-pfos-table": "planning.budget_template_version",
  "x-pfos-context": "planning"
}
