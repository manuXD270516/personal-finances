{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/loans.schema.json",
  "title": "pfos-export v1 — loans",
  "description": "Registro de la sección «loans» (tabla debt.loan, contexto debt). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "name",
    "account_id",
    "disbursement_account_id",
    "payment_account_id",
    "lender_counterparty_id",
    "principal",
    "currency",
    "annual_rate",
    "rate_type",
    "day_count",
    "frequency",
    "term_installments",
    "method",
    "disbursement_date",
    "first_due_date",
    "charges",
    "retained_fee",
    "origin",
    "existing_as_of",
    "existing_outstanding",
    "next_installment_no",
    "status",
    "current_schedule_version",
    "recurring_definition_id",
    "disbursement_transaction_id",
    "cancelled_reason",
    "created_by",
    "created_at",
    "updated_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "disbursement_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "payment_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "lender_counterparty_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "principal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "annual_rate": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "rate_type": {
      "type": "string"
    },
    "day_count": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "term_installments": {
      "type": "integer"
    },
    "method": {
      "type": "string"
    },
    "disbursement_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "first_due_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "charges": {
      "description": "JSON libre (no nulo).",
      "not": {
        "type": "null"
      }
    },
    "retained_fee": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "origin": {
      "type": "string"
    },
    "existing_as_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "existing_outstanding": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "next_installment_no": {
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "current_schedule_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "recurring_definition_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "disbursement_transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "cancelled_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "version": {
      "type": "integer"
    }
  },
  "x-pfos-table": "debt.loan",
  "x-pfos-context": "debt"
}
