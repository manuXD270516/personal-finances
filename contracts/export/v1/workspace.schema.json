{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/workspace.schema.json",
  "title": "pfos-export v1 — workspace",
  "description": "Registro de la sección «workspace» (tabla iam.workspace, contexto identity). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "base_currency",
    "time_zone",
    "locale",
    "fiscal_month_start_day",
    "min_liquidity_reserve_amount",
    "min_liquidity_reserve_currency",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "base_currency": {
      "type": "string"
    },
    "time_zone": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "fiscal_month_start_day": {
      "type": "integer"
    },
    "min_liquidity_reserve_amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "min_liquidity_reserve_currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "iam.workspace",
  "x-pfos-context": "identity"
}
