{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/budget-threshold-crossings.schema.json",
  "title": "pfos-export v1 — budget-threshold-crossings",
  "description": "Registro de la sección «budget-threshold-crossings» (tabla planning.budget_threshold_crossing, contexto planning). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "period_id",
    "target_kind",
    "target_id",
    "threshold",
    "budget_id",
    "budget_line_id",
    "reference_amount",
    "actual_amount",
    "currency",
    "crossed_at",
    "event_id"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "period_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_kind": {
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "threshold": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "budget_id": {
      "type": "string",
      "format": "uuid"
    },
    "budget_line_id": {
      "type": "string",
      "format": "uuid"
    },
    "reference_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "actual_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "crossed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "x-pfos-table": "planning.budget_threshold_crossing",
  "x-pfos-context": "planning"
}
