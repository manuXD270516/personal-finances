{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/goal-movements.schema.json",
  "title": "pfos-export v1 — goal-movements",
  "description": "Registro de la sección «goal-movements» (tabla goals.goal_movement, contexto goals). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "goal_id",
    "fund",
    "movement",
    "amount",
    "currency",
    "account_id",
    "occurred_on",
    "transaction_id",
    "transaction_revision",
    "reverses_id",
    "reassignment_id",
    "origin",
    "note",
    "recorded_at",
    "recorded_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "fund": {
      "type": "string"
    },
    "movement": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_on": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "transaction_revision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reverses_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "reassignment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "origin": {
      "type": "string"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "recorded_by": {
      "type": "string",
      "format": "uuid"
    }
  },
  "x-pfos-table": "goals.goal_movement",
  "x-pfos-context": "goals"
}
