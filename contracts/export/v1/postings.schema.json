{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/postings.schema.json",
  "title": "pfos-export v1 — postings",
  "description": "Registro de la sección «postings» (tabla ledger.posting, contexto ledger). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "journal_entry_id",
    "entry_date",
    "line_no",
    "ledger_account_id",
    "account_type",
    "currency",
    "amount",
    "split_id",
    "memo",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "journal_entry_id": {
      "type": "string",
      "format": "uuid"
    },
    "entry_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "line_no": {
      "type": "integer"
    },
    "ledger_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_type": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "split_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "memo": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  },
  "x-pfos-table": "ledger.posting",
  "x-pfos-context": "ledger"
}
