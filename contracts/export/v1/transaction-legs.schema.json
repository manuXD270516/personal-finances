{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pfos.local/export/v1/transaction-legs.schema.json",
  "title": "pfos-export v1 — transaction-legs",
  "description": "Registro de la sección «transaction-legs» (tabla txn.transaction_leg, contexto transactions). Montos como texto decimal exacto; instantes ISO-8601 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "transaction_id",
    "account_id",
    "account_nature",
    "role",
    "amount",
    "currency",
    "transaction_date",
    "revision",
    "superseded_in_revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_nature": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string"
    },
    "transaction_date": {
      "type": "string",
      "pattern": "^(-?infinity|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "revision": {
      "type": "integer"
    },
    "superseded_in_revision": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "x-pfos-table": "txn.transaction_leg",
  "x-pfos-context": "transactions"
}
