# Caddy — único proceso con puertos públicos en producción N1 (ADR-0027, SPIKE-09 §11). TLS automático (ACME,
# Let's Encrypt) para los dos hostnames; HSTS; consola de Keycloak bloqueada desde Internet.
{
	email {$PF_ACME_EMAIL}
	# pf-allow-loopback: API de administración de Caddy solo dentro del contenedor
	admin localhost:2019
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# finance-web (Next.js BFF). El navegador solo habla con este origen y con el de Keycloak.
{$PF_DOMAIN_APP} {
	import security_headers
	encode zstd gzip
	reverse_proxy finance-web:3000
}

# Subida directa de documentos (openspec add-document-attachments, D316): hostname propio que SOLO deja pasar `PUT` y
# `OPTIONS` sobre el bucket de cuarentena con la firma presignada en la query (`X-Amz-Signature`). Sin `GET`, `LIST` ni acceso
# a otros buckets: todo lo demás responde 404. La descarga de documentos pasa siempre por la API (cifrado de la aplicación).
{$PF_DOMAIN_FILES} {
	import security_headers
	@signed_put {
		method PUT
		path /{$PF_QUARANTINE_BUCKET}/ws/*
		query X-Amz-Signature=*
	}
	@preflight {
		method OPTIONS
		path /{$PF_QUARANTINE_BUCKET}/ws/*
	}
	handle @signed_put {
		reverse_proxy object-storage:8333
	}
	handle @preflight {
		reverse_proxy object-storage:8333
	}
	handle {
		respond 404
	}
}

# Keycloak (issuer OIDC = https://{$PF_DOMAIN_AUTH}/realms/pfos).
{$PF_DOMAIN_AUTH} {
	import security_headers
	@admin path /admin /admin/*
	respond @admin 404
	reverse_proxy keycloak:8080
}
