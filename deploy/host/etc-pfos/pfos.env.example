# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# PFOS — /etc/pfos/pfos.env de PRODUCCIÓN N1 (VERSIONADO SIN SECRETOS). ADR-0027, docs/runbooks/deploy-and-restore.md.
# Mismo contrato que el `.env` local (docs/19 §0.3, docs/config-reference.md): lo leen Compose (`--env-file`) y los
# contenedores de la app (`PF_APP_ENV_FILE`). En el host: root:root 0600; nunca se copia al repo ni a CI.
#
# Generar los secretos UNA vez en el host (runbook §2.3):
#   while grep -q '__generate__' pfos.env; do sed -i "0,/__generate__/s//$(openssl rand -hex 32)/" pfos.env; done
# Las claves con formato `kid:secreto` llevan el prefijo `k1:` ya escrito. Reemplazar también cada `__set__`.
# Los nombres PF_DEV_* son los nombres de interpolación del compose base: en producción tienen valores propios.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────

# ── Plataforma (solo Compose) ──
PF_BIND_ADDR=127.0.0.1
PF_PUBLIC_BIND_ADDR=0.0.0.0
PF_POSTGRES_PORT=25432
PF_OBJECT_STORAGE_PORT=29000
PF_MAILPIT_UI_PORT=28025
PF_MAILPIT_SMTP_PORT=21025
PF_KEYCLOAK_PORT=28081
PF_API_PORT=28080
PF_WEB_PORT=23000
PF_APP_ENV_FILE=/etc/pfos/pfos.env
PF_PGBACKREST_ENV_FILE=/etc/pfos/pgbackrest.env
PF_DOMAIN_APP=__set__
PF_DOMAIN_AUTH=__set__
PF_ACME_EMAIL=__set__
# Gateway OTLP de Grafana Cloud (Connections → OpenTelemetry), p. ej. https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
PF_OTLP_ENDPOINT=__set__
# Opcional: dead-man's switch de los backups (p. ej. https://hc-ping.com/<ping-key>, healthchecks.io gratis). Vacío = sin aviso.
PF_BACKUP_HEARTBEAT_URL=

# ── Secretos del host (generados con openssl, nunca reutilizados de local) ──
PF_DEV_PG_SUPERUSER_PASSWORD=__generate__
PF_DEV_DB_MIGRATOR_PASSWORD=__generate__
PF_DEV_DB_APP_PASSWORD=__generate__
PF_DEV_DB_BFF_PASSWORD=__generate__
PF_DEV_DB_WORKER_PASSWORD=__generate__
PF_DEV_KEYCLOAK_DB_PASSWORD=__generate__
PF_DEV_KEYCLOAK_ADMIN_PASSWORD=__generate__
PF_DEV_OIDC_CLIENT_SECRET=__generate__
# No se usan en producción (el realm de prod no tiene usuarios demo), pero el compose base los exige.
PF_DEV_KC_OWNER_PASSWORD=unused-in-production
PF_DEV_KC_EDITOR_PASSWORD=unused-in-production
PF_DEV_KC_VIEWER_PASSWORD=unused-in-production
PF_DEV_KC_OUTSIDER_PASSWORD=unused-in-production
PF_DEV_S3_ACCESS_KEY=__generate__
PF_DEV_S3_SECRET_KEY=__generate__

# ── Runtime de la aplicación ──
PFOS_ENV=production
LOG_LEVEL=info
APP_DEFAULT_LOCALE=es-BO
APP_REPORTING_CURRENCY=BOB
APP_TIMEZONE=America/La_Paz
DEMO_DATA_ENABLED=false

# Direcciones internas: compose.yaml las vuelve a fijar para la red Compose (aquí solo por completitud del contrato).
DATABASE_URL=postgres://pf_app:${PF_DEV_DB_APP_PASSWORD}@postgres:5432/pfos?sslmode=disable
DATABASE_MIGRATOR_URL=postgres://pf_migrator:${PF_DEV_DB_MIGRATOR_PASSWORD}@postgres:5432/pfos?sslmode=disable
WORKER_DATABASE_URL=postgres://pf_worker:${PF_DEV_DB_WORKER_PASSWORD}@postgres:5432/pfos?sslmode=disable
BFF_DATABASE_URL=postgres://pf_bff:${PF_DEV_DB_BFF_PASSWORD}@postgres:5432/pfos?sslmode=disable
# 2 GB de RAM: pools chicos (max_connections=60 en compose.prod.yaml). El worker necesita al menos la concurrencia
# sumada de sus consumidores de eventos (EVENT_CONSUMER_CONCURRENCY × consumidores) + 4 conexiones reservadas. Son 22
# desde add-basic-csv-import: el consumidor `imports.persist` suma 1 a la concurrencia y, mientras persiste un lote, usa
# además la conexión de su transacción de lote (la entrega del evento conserva la suya). 22 + 22 (api) < 60 de Postgres.
DATABASE_POOL_MAX=22

OBJECT_STORAGE_ENDPOINT=http://object-storage:8333
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=pfos-prod-documents
# Archivos de export del workspace (add-workspace-export): bucket SIN versioning que crea pfos-bootstrap-storage.sh.
OBJECT_STORAGE_EXPORTS_BUCKET=pfos-prod-exports
OBJECT_STORAGE_ACCESS_KEY=${PF_DEV_S3_ACCESS_KEY}
OBJECT_STORAGE_SECRET_KEY=${PF_DEV_S3_SECRET_KEY}
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# En producción el bucket lo crea deploy/host/pfos-bootstrap-storage.sh (OBJECT_STORAGE_ENSURE_BUCKET se rechaza).
OBJECT_STORAGE_ENSURE_BUCKET=false

JOB_QUEUE_DRIVER=pgboss
JOB_QUEUE_POLLING_INTERVAL_SECONDS=0.5
SESSION_STORE=postgres

API_PORT=8080
API_BIND_ADDRESS=0.0.0.0
SHUTDOWN_TIMEOUT_MS=25000
CURSOR_SIGNING_KEY=k1:__generate__
AUDIT_IP_HMAC_KEY=k1:__generate__
# Clave maestra de los exports del workspace (32 bytes en hexadecimal: `openssl rand -hex 32`). Perderla deja indescifrables
# los exports vigentes (son temporales: se vuelve a exportar). Rotar = agregar `k2:…` y fijar EXPORT_ENCRYPTION_ACTIVE_KEY_ID.
EXPORT_ENCRYPTION_KEYS=k1:__generate__
EXPORT_ENCRYPTION_ACTIVE_KEY_ID=k1
EXPORT_RETENTION=7d
REAUTH_MAX_AGE=10m
WORKSPACE_IMPORT_MAX_BYTES=209715200
RATE_LIMIT_STORE=memory
WORKER_CONCURRENCY=2
EVENT_CONSUMER_CONCURRENCY=1
EVENT_CONSUMER_BATCH_SIZE=10
WORKER_HEALTH_PORT=8082
WORKER_HEALTH_BIND_ADDRESS=0.0.0.0
LEDGER_INTEGRITY_CRON=0 4 * * *
LEDGER_INTEGRITY_CRON_TZ=UTC
PLANNING_PERIOD_LOOKAHEAD=3
PLANNING_PERIODS_CRON=5 * * * *
PLANNING_CLOSE_PENDING_DELAY_DAYS=3
COMMITMENTS_HORIZON_DAYS=90
COMMITMENTS_SCHEDULER_CRON=10 * * * *
COMMITMENTS_SUBSCRIPTIONS_CRON=20 * * * *
# Imports CSV (add-basic-csv-import): límites del archivo, lotes de persistencia y retención de las celdas crudas.
IMPORT_CSV_MAX_BYTES=2097152
IMPORT_CSV_MAX_ROWS=5000
IMPORT_CSV_MAX_COLUMNS=50
IMPORT_PERSIST_BATCH_SIZE=200
IMPORT_REVIEW_TTL=P30D
IMPORT_STAGING_RETENTION=P90D
IMPORT_FUTURE_DATE_TOLERANCE_DAYS=3
IMPORT_MAINTENANCE_CRON=40 3 * * *
# Ventana de vigencia de las tasas de valoración (Home, presupuestos): la leen la API y el worker; mismo valor en ambos.
REPORTING_RATE_VALIDITY_WINDOW=7d

# Notificaciones (add-alerts): sin proveedor de email elegido todavía (docs/33 D87) ⇒ solo in-app. El change de despliegue
# elegirá el proveedor (relay SMTP + API HTTP con Idempotency-Key) y cambiará EMAIL_DRIVER/SMTP_*/EMAIL_FROM aquí.
EMAIL_DRIVER=none
EMAIL_FROM=notificaciones@pfos.invalid
APP_PUBLIC_URL=${WEB_PUBLIC_URL}
NOTIFY_EMAIL_MAX_ATTEMPTS=5
NOTIFY_RETENTION=12mo

FX_PROVIDER_PRIMARY=paralelo_bo
FX_PROVIDER_FALLBACK=dolarapi_bo
FX_PROVIDER_OFFICIAL=dolarapi_bo
FX_POLL_INTERVAL=15m

# ── Identidad: Keycloak detrás de Caddy (issuer = URL pública) ──
OIDC_PUBLIC_BASE_URL=https://${PF_DOMAIN_AUTH}
WEB_PUBLIC_URL=https://${PF_DOMAIN_APP}
OIDC_ISSUER_URL=${OIDC_PUBLIC_BASE_URL}/realms/pfos

# ── BFF ──
FINANCE_API_URL=http://finance-api:8080
OIDC_CLIENT_ID=pfos-web
OIDC_CLIENT_SECRET=${PF_DEV_OIDC_CLIENT_SECRET}
OIDC_SCOPES=openid profile email pfos.api
BFF_SESSION_ENC_KEY=k1:__generate__
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

# ── OpenTelemetry → Grafana Cloud Free (SPIKE-10: sin detectores host/process) ──
OTEL_ENABLED=true
OTEL_NODE_RESOURCE_DETECTORS=env,os,serviceinstance
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# "Authorization=Basic <base64(instanceId:token)>" con el espacio codificado como %20 (token de solo escritura).
OTEL_EXPORTER_OTLP_HEADERS=__set__
