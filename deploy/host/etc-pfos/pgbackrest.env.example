# PFOS — /etc/pfos/pgbackrest.env (VERSIONADO SIN SECRETOS). root:root 0600. Lo recibe SOLO el contenedor postgres.
# Bucket: `tofu output b2_bucket_name`; endpoint y región: consola de B2 (Buckets → Endpoint). Clave: `tofu output -raw
# b2_host_key_id` / `b2_host_key_secret` (sensible; se copia al host y NO queda en ningún otro lugar salvo el state
# cifrado). Passphrases de cifrado: generar con `openssl rand -base64 48` y guardar una copia cifrada (age) en el gestor
# de contraseñas del owner — sin ellas los backups son irrecuperables.
PGBACKREST_REPO1_S3_BUCKET=__set__
# Endpoint S3 de B2 SIN esquema (p. ej. s3.us-west-004.backblazeb2.com) y su región (us-west-004).
PGBACKREST_REPO1_S3_ENDPOINT=__set__
PGBACKREST_REPO1_S3_REGION=__set__
PGBACKREST_REPO1_S3_KEY=__set__
PGBACKREST_REPO1_S3_KEY_SECRET=__set__
PGBACKREST_REPO1_CIPHER_PASS=__set__
PGBACKREST_REPO2_S3_BUCKET=__set__
PGBACKREST_REPO2_S3_ENDPOINT=__set__
PGBACKREST_REPO2_S3_REGION=__set__
PGBACKREST_REPO2_S3_KEY=__set__
PGBACKREST_REPO2_S3_KEY_SECRET=__set__
PGBACKREST_REPO2_CIPHER_PASS=__set__
