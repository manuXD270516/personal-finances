# PFOS — limpieza de imágenes (add-host-restore-drill). La dispara pfos-image-prune.timer; toma el lock del deploy y avisa al heartbeat pfos-image-prune.
[Unit]
Description=PFOS limpieza de imágenes
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/pfos/repo/deploy/host/pfos-backup.sh image-prune
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
