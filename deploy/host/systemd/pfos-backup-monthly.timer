# PFOS — backup full mensual (repo2, 12 meses) (UTC; La Paz = UTC−4). Instalado y habilitado por deploy/host/pfos-deploy.sh.
[Unit]
Description=PFOS backup full mensual (repo2, 12 meses)

[Timer]
OnCalendar=*-*-01 07:00:00 UTC
Unit=pfos-backup@monthly.service
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
