# PFOS — job de backup (docs/30 §4.1). Instalado por deploy/host/pfos-deploy.sh; lo disparan los timers pfos-*.timer.
[Unit]
Description=PFOS backup (%i)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/pfos/repo/deploy/host/pfos-backup.sh %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
