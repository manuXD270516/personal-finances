# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# PFOS — .env.example (VERSIONADO, SIN SECRETOS). Referencia: docs/19 §0.3 y docs/config-reference.md.
#
#   pnpm setup:env      → crea `.env` (ignorado por git) desde este fichero: reemplaza cada valor
#                         `__generate__` por un secreto de desarrollo aleatorio y avisa si algún puerto PF_*
#                         está ocupado (con `--apply-ports` usa la alternativa libre sugerida).
#
# Un solo `.env` para todo: lo leen Compose y los procesos del host. Los valores son los del MODO A (apps en el
# host contra `deps` en contenedores); en MODO B compose.yaml sobrescribe solo las direcciones.
# Todas las credenciales PF_DEV_* son SOLO PARA DESARROLLO LOCAL: nunca se reutilizan en otro entorno.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────

# ── Plataforma local (solo Compose y scripts/*.ts) ──
PF_BIND_ADDR=127.0.0.1
PF_POSTGRES_PORT=25432
PF_OBJECT_STORAGE_PORT=29000
PF_MAILPIT_UI_PORT=28025
PF_MAILPIT_SMTP_PORT=21025
PF_KEYCLOAK_PORT=28081
PF_API_PORT=28080
PF_WORKER_HEALTH_PORT=28082
PF_WEB_PORT=23000
PF_VALKEY_PORT=26379
PF_GRAFANA_PORT=23001
PF_OTLP_GRPC_PORT=24317
PF_OTLP_HTTP_PORT=24318

# ── Secretos de desarrollo (generados por `pnpm setup:env`) ──
PF_DEV_PG_SUPERUSER_PASSWORD=__generate__
PF_DEV_DB_MIGRATOR_PASSWORD=__generate__
PF_DEV_DB_APP_PASSWORD=__generate__
PF_DEV_DB_BFF_PASSWORD=__generate__
PF_DEV_DB_WORKER_PASSWORD=__generate__
PF_DEV_KEYCLOAK_DB_PASSWORD=__generate__
PF_DEV_KEYCLOAK_ADMIN_PASSWORD=__generate__
PF_DEV_OIDC_CLIENT_SECRET=__generate__
# Usuarios del realm `pfos` de Keycloak (Minimal Seed, docs/29): owner, editor, viewer y outsider
# (<usuario>@demo.pfos.test). Sus contraseñas son estas variables del `.env` local.
PF_DEV_KC_OWNER_PASSWORD=__generate__
PF_DEV_KC_EDITOR_PASSWORD=__generate__
PF_DEV_KC_VIEWER_PASSWORD=__generate__
PF_DEV_KC_OUTSIDER_PASSWORD=__generate__
# Secreto del que se deriva la clave AES-256-GCM de las sesiones del BFF (BFF_SESSION_ENC_KEY).
PF_DEV_BFF_SESSION_SECRET=__generate__
PF_DEV_S3_ACCESS_KEY=__generate__
PF_DEV_S3_SECRET_KEY=__generate__
# Clave maestra (32 bytes en base64url) que envuelve las claves de datos de los exports del workspace (add-workspace-export).
PF_DEV_EXPORT_MASTER_KEY=__generate__

# ── Runtime de la aplicación (esquema validado al arrancar: packages/platform/src/config) ──
PFOS_ENV=local
LOG_LEVEL=info
APP_DEFAULT_LOCALE=es-BO
APP_REPORTING_CURRENCY=BOB
APP_TIMEZONE=America/La_Paz
# "Cargar datos de demostración" (add-demo-data, ADR-0026): sin valor ⇒ true en local/ci, false en staging/production.
DEMO_DATA_ENABLED=true

DATABASE_URL=postgres://pf_app:${PF_DEV_DB_APP_PASSWORD}@${PF_BIND_ADDR}:${PF_POSTGRES_PORT}/pfos?sslmode=disable
DATABASE_MIGRATOR_URL=postgres://pf_migrator:${PF_DEV_DB_MIGRATOR_PASSWORD}@${PF_BIND_ADDR}:${PF_POSTGRES_PORT}/pfos?sslmode=disable
# finance-worker (relay del outbox): rol pf_worker; `migrate` le fija esta contraseña.
WORKER_DATABASE_URL=postgres://pf_worker:${PF_DEV_DB_WORKER_PASSWORD}@${PF_BIND_ADDR}:${PF_POSTGRES_PORT}/pfos?sslmode=disable
# El worker necesita: EVENT_CONSUMER_CONCURRENCY de cada consumidor (suma) + 4 conexiones reservadas.
DATABASE_POOL_MAX=30

OBJECT_STORAGE_ENDPOINT=http://${PF_BIND_ADDR}:${PF_OBJECT_STORAGE_PORT}
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=pfos-local-documents
OBJECT_STORAGE_ACCESS_KEY=${PF_DEV_S3_ACCESS_KEY}
OBJECT_STORAGE_SECRET_KEY=${PF_DEV_S3_SECRET_KEY}
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ENSURE_BUCKET=true
OBJECT_STORAGE_CORS_ORIGINS=http://localhost:${PF_WEB_PORT},http://127.0.0.1:${PF_WEB_PORT}

# ── Exportación / importación del workspace (add-workspace-export, docs/33 D98–D102; docs/30 §10–§11) ──
# Bucket de los archivos de export cifrados (sin versioning; `migrate` lo crea con OBJECT_STORAGE_ENSURE_BUCKET=true).
OBJECT_STORAGE_EXPORTS_BUCKET=pfos-local-exports
# Llavero de claves maestras (`kid:clave[,kid:clave…]`, 32 bytes en base64url) y la vigente. Solo desarrollo local: en cloud
# viene del secrets manager/KMS y se rota agregando una clave nueva sin quitar las anteriores hasta que expiren sus exports.
EXPORT_ENCRYPTION_KEYS=dev1:${PF_DEV_EXPORT_MASTER_KEY}
EXPORT_ENCRYPTION_ACTIVE_KEY_ID=dev1
# Retención del archivo exportado y antigüedad máxima de la autenticación para exportar/descargar/importar.
EXPORT_RETENTION=7d
REAUTH_MAX_AGE=10m
WORKSPACE_IMPORT_MAX_BYTES=209715200

JOB_QUEUE_DRIVER=pgboss
JOB_QUEUE_POLLING_INTERVAL_SECONDS=0.5
SESSION_STORE=postgres
# Solo con JOB_QUEUE_DRIVER=bullmq o SESSION_STORE=valkey (+ perfil `valkey`).
VALKEY_URL=redis://${PF_BIND_ADDR}:${PF_VALKEY_PORT}/0

API_PORT=${PF_API_PORT}
API_BIND_ADDRESS=${PF_BIND_ADDR}
HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=25000
# Convenciones de API (add-api-conventions). CURSOR_SIGNING_KEY (kid:secreto) es obligatoria en
# staging/production; en local, si falta, la API usa una clave efímera.
# Auditoría (add-audit-trail). AUDIT_IP_HMAC_KEY (kid:secreto) es obligatoria en staging/production; en local,
# si falta, se usa una clave efímera (los hashes de IP de distintos arranques no son comparables).
IDEMPOTENCY_RETENTION=24h
RATE_LIMIT_STORE=memory
RATE_LIMIT_READS_PER_MIN=600
RATE_LIMIT_WRITES_PER_MIN=120
WORKER_CONCURRENCY=4
EVENT_CONSUMER_CONCURRENCY=4
EVENT_CONSUMER_BATCH_SIZE=10
WORKER_HEALTH_PORT=${PF_WORKER_HEALTH_PORT}
WORKER_HEALTH_BIND_ADDRESS=${PF_BIND_ADDR}

# ── FX: providers de tasas de mercado (add-market-rate-providers; ADR-0025; docs/config-reference.md) ──
# El worker consulta paralelo.bo (principal, CC BY 4.0) y bo.dolarapi.com (respaldo y oficial) cada FX_POLL_INTERVAL
# con solicitudes anónimas (sin datos del usuario). `none` deshabilita un rol; con los tres en `none` no se consulta
# ninguna red y el core sigue con tasas manuales. Los tests (`test:stack`, Testcontainers) fuerzan `none`.
# Modo B (`--profile core`): el contenedor finance-worker sale por la red Compose por defecto (HTTPS 443 a paralelo.bo
# y bo.dolarapi.com); detrás de un firewall/proxy corporativo permite ese egress (docs/19-local-development.md).
FX_PROVIDER_PRIMARY=paralelo_bo
FX_PROVIDER_FALLBACK=dolarapi_bo
FX_PROVIDER_OFFICIAL=dolarapi_bo
FX_POLL_INTERVAL=15m
FX_STALE_AFTER_PARALLEL=60m
FX_STALE_AFTER_OFFICIAL=48h
FX_STALE_AFTER_FALLBACK=180m
FX_MANUAL_FALLBACK_MAX_AGE=24h
FX_ANOMALY_THRESHOLD_PCT=5
FX_PROVIDER_TIMEOUT=10s
FX_BACKFILL_ENABLED=true
# Solo local/CI: FX_PROVIDER_PARALELO_BO_URL / FX_PROVIDER_DOLARAPI_BO_URL apuntan el worker a providers simulados
# (las pruebas E2E los sirven desde el harness); sin definir se usan los reales. Rechazadas en staging/production.

# ── Reporting (docs/31 D53) — ventana de vigencia de las tasas de valoración y de referencia (FX la recibe) ──
REPORTING_RATE_VALIDITY_WINDOW=7d

# ── Planning (add-financial-periods, docs/33 D63) — periodos DRAFT futuros y cron del job planning.ensure-periods ──
PLANNING_PERIOD_LOOKAHEAD=3
PLANNING_PERIODS_CRON=5 * * * *
PLANNING_CLOSE_PENDING_DELAY_DAYS=3

# ── Notificaciones (add-alerts, docs/33 D87–D93) — canal email del worker ──
# `smtp` envía por SMTP: en local y CI es Mailpit (SMTP en PF_MAILPIT_SMTP_PORT, UI en PF_MAILPIT_UI_PORT; los emails
# no salen a internet). `none` suprime el email (solo in-app). En producción el proveedor se elige en el change de
# despliegue; mientras tanto EMAIL_DRIVER=none. Nunca credenciales reales aquí. Modo B: Compose apunta SMTP_HOST a mailpit.
EMAIL_DRIVER=smtp
SMTP_HOST=${PF_BIND_ADDR}
SMTP_PORT=${PF_MAILPIT_SMTP_PORT}
SMTP_SECURE=false
EMAIL_FROM=notificaciones@pfos.local
# Base de los enlaces de los emails (/notificaciones/{id}, /preferencias): el origen público de la app.
APP_PUBLIC_URL=${WEB_PUBLIC_URL}
NOTIFY_EMAIL_MAX_ATTEMPTS=5
NOTIFY_RETENTION=12mo

# ── Identidad (Keycloak dev) — URL pública que ve el navegador = issuer ──
OIDC_PUBLIC_BASE_URL=http://localhost:${PF_KEYCLOAK_PORT}
WEB_PUBLIC_URL=http://localhost:${PF_WEB_PORT}
# Emisor exacto de los tokens (finance-api valida `iss`; el BFF hace discovery). En modo B, Compose agrega las
# direcciones de back-channel (OIDC_JWKS_URI de la API y OIDC_DISCOVERY_URL del BFF hacia keycloak:8080).
OIDC_ISSUER_URL=${OIDC_PUBLIC_BASE_URL}/realms/pfos

# ── BFF (finance-web): login OIDC, sesiones en iam.bff_session (rol pf_bff) y proxy a finance-api ──
FINANCE_API_URL=http://${PF_BIND_ADDR}:${PF_API_PORT}
OIDC_CLIENT_ID=pfos-web
OIDC_CLIENT_SECRET=${PF_DEV_OIDC_CLIENT_SECRET}
OIDC_SCOPES=openid profile email pfos.api
BFF_DATABASE_URL=postgres://pf_bff:${PF_DEV_DB_BFF_PASSWORD}@${PF_BIND_ADDR}:${PF_POSTGRES_PORT}/pfos?sslmode=disable
BFF_SESSION_ENC_KEY=${PF_DEV_BFF_SESSION_SECRET}
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

# ── OpenTelemetry (perfil `observability`) ──
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://${PF_BIND_ADDR}:${PF_OTLP_HTTP_PORT}
OTEL_NODE_RESOURCE_DETECTORS=env,os,serviceinstance

# ── Imágenes (vacío = build local pfos/finance-*:local; en CI/staging: repo@sha256:…) ──
FINANCE_API_IMAGE=
FINANCE_WEB_IMAGE=
