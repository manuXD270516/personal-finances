# SPIKE-08 — host ports (PF_*_PORT). Spike defaults in 618xx; see README for the product proposal (2xxxx block).
PF_BIND_ADDR=127.0.0.1
PF_PG_PORT=61832
PF_VALKEY_PORT=61837
PF_API_PORT=61880
PF_OTLP_HTTP_PORT=61838
PF_PG_PASSWORD=pf_dev_only
# migration file run by the one-shot `migrate` (fail.sql reproduces a failing migration)
PF_MIGRATE_FILE=001_ok.sql
