# SPIKE-06 — valores SOLO de desarrollo, generados aleatoriamente para este spike.
# No son credenciales reales ni deben reutilizarse fuera del realm de dev.
# Copiar a .env:  node scripts/init-env.mjs
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-only-ezily9Gk5jzKsaz1

APP_ORIGIN=http://localhost:61600
OIDC_ISSUER=http://localhost:61681/realms/pfos
OIDC_CLIENT_ID=pfos-bff
OIDC_CLIENT_SECRET=dev-only-dfNrnpo1IhLi8dEX91xHv51VN1VcRfDU
OIDC_REDIRECT_URI=http://localhost:61600/api/bff/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:61600/
OIDC_SCOPE=openid profile email
# AES-256-GCM (32 bytes base64) para cifrar tokens en el session store
SESSION_ENC_KEY=CHANGE_ME_base64_32_bytes  # generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VALKEY_URL=redis://localhost:61682/0
API_URL=http://127.0.0.1:61680
# Habilita /api/bff/dev/* (forzar expiración del access token). Nunca en prod.
BFF_DEV_ENDPOINTS=1

# finance-api
API_PORT=61680
JWT_AUDIENCE=finance-api
JWT_ALLOWED_AZP=pfos-bff,pfos-e2e

# Solo tests E2E (clientes y usuarios del realm de dev)
