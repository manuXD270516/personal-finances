{
  "name": "@pf/debt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded context DEBT: préstamos, cronograma francés, pagos con desglose y comparación con la tabla del banco (openspec add-loans).",
  "exports": {
    "./contracts": {
      "@pf/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./interface/debt.module": {
      "@pf/source": "./src/interface/debt.module.ts",
      "types": "./dist/interface/debt.module.d.ts",
      "default": "./dist/interface/debt.module.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@pf/accounts": "workspace:*",
    "@pf/audit": "workspace:*",
    "@pf/classification": "workspace:*",
    "@pf/commitments": "workspace:*",
    "@pf/fx": "workspace:*",
    "@pf/identity": "workspace:*",
    "@pf/ledger": "workspace:*",
    "@pf/planning": "workspace:*",
    "@pf/platform": "workspace:*",
    "@pf/shared-kernel": "workspace:*",
    "@pf/transactions": "workspace:*",
    "busboy": "1.6.0",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-check": "4.10.2",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
