{
  "name": "@pf/commitments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded context COMMITMENTS: motor de recurrencia, ocurrencias y total comprometido (openspec add-recurrence-engine).",
  "exports": {
    "./contracts": {
      "@pf/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./interface/commitments.module": {
      "@pf/source": "./src/interface/commitments.module.ts",
      "types": "./dist/interface/commitments.module.d.ts",
      "default": "./dist/interface/commitments.module.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@pf/accounts": "workspace:*",
    "@pf/audit": "workspace:*",
    "@pf/classification": "workspace:*",
    "@pf/fx": "workspace:*",
    "@pf/identity": "workspace:*",
    "@pf/platform": "workspace:*",
    "@pf/shared-kernel": "workspace:*",
    "@pf/transactions": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-check": "4.10.2",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
