{
  "name": "@pf/reporting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded context REPORTING (lado de lectura): resumen del Home, KPIs del mes y patrimonio neto actual (openspec add-basic-dashboard).",
  "exports": {
    "./contracts": {
      "@pf/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./interface/reporting.module": {
      "@pf/source": "./src/interface/reporting.module.ts",
      "types": "./dist/interface/reporting.module.d.ts",
      "default": "./dist/interface/reporting.module.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@pf/accounts": "workspace:*",
    "@pf/classification": "workspace:*",
    "@pf/fx": "workspace:*",
    "@pf/ledger": "workspace:*",
    "@pf/platform": "workspace:*",
    "@pf/shared-kernel": "workspace:*",
    "@pf/transactions": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "fast-check": "4.10.2",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
