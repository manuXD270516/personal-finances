      { "labels": ["Créditos", "Débitos"], "role": "AMOUNT", "align": "RIGHT" }
    ],
    "rowAnchor": "AMOUNT",
    "sections": [
      { "id": "DEPOSITS", "startLabel": "Depósitos", "totalLabel": "Total depósitos", "sign": "CREDIT" },
      { "id": "WITHDRAWALS", "startLabel": "Retiros", "totalLabel": "Total retiros", "sign": "DEBIT" }
    ],
    "counterpartyStarts": ["Cuenta Destino:"],
    "dropLinePrefixes": ["CUENTA:"]
  },
  "page": {
    "repeatedLiterals": [],
    "footerLiterals": ["Página"],
    "blankPageLiterals": ["Esta página se dejó en blanco intencionalmente"],
    "discardLiterals": ["| Número de cuenta"]
  },
  "number": { "decimal": ".", "thousands": "," },
  "date": "DD/MM/YYYY",
  "time": "HH:mm",
  "reference": { "unique": false },
  "volatileFragments": []
}
