{
  "schema": "imports.pdf-layout.v1",
  "id": "bo.bnb.cuenta",
  "version": 1,
  "currencyLabels": [{ "label": "BOLIVIANOS", "currency": "BOB" }],
  "detect": { "literals": ["Tu Banca Personal", "Resumen de cuenta"] },
  "header": {
    "account": { "label": "Número de cuenta:" },
    "period": { "kind": "LONG_DATE_RANGE" },
    "openingBalance": { "kind": "LABEL", "label": "Saldo al", "occurrence": "FIRST" },
    "closingBalance": { "kind": "LABEL", "label": "Saldo al", "occurrence": "LAST" },
    "totalDebits": { "label": "Total de débitos" },
    "totalCredits": { "label": "Total de créditos" },
    "totalPages": { "kind": "PAGE_N_OF_M" }
  },
  "table": {
    "columns": [
      { "labels": ["Fecha"], "role": "DATE", "align": "LEFT" },
      { "labels": ["Hora"], "role": "TIME", "align": "LEFT" },
      { "labels": ["Descripción"], "role": "DESCRIPTION", "align": "LEFT" },
      { "labels": ["Referencia"], "role": "REFERENCE", "align": "LEFT" },
      { "labels": ["Comprobante"], "role": "IGNORE", "align": "LEFT" },
