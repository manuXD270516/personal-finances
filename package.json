{
  "name": "pfos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @pf/e2e run test:e2e",
    "perf:bench": "pnpm --filter @pf/api run perf:bench",
    "fx:smoke-live": "pnpm --filter @pf/fx run smoke:live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:validate": "cross-env OPENSPEC_TELEMETRY=0 DO_NOT_TRACK=1 OPENSPEC_NO_UPDATE_CHECK=1 openspec validate --all --strict --no-interactive",
    "arch:check": "depcruise apps packages scripts --config .dependency-cruiser.cjs --output-type err-long",
    "config:docs": "pnpm --filter @pf/platform run config:docs",
    "config:docs:check": "pnpm --filter @pf/platform run config:docs:check",
    "setup:env": "tsx scripts/stack/src/setup-env.ts",
    "stack:up": "tsx scripts/stack/src/stack.ts up",
    "stack:down": "tsx scripts/stack/src/stack.ts down",
    "stack:restart": "tsx scripts/stack/src/stack.ts restart",
    "stack:logs": "tsx scripts/stack/src/stack.ts logs",
    "stack:ps": "tsx scripts/stack/src/stack.ts ps",
    "stack:reset": "tsx scripts/stack/src/stack.ts reset",
    "db:migrate": "tsx scripts/stack/src/db.ts migrate",
    "db:seed": "tsx scripts/stack/src/db.ts seed",
    "backup:local": "tsx scripts/stack/src/backup.ts",
    "restore:local": "tsx scripts/stack/src/restore.ts",
    "images:build": "tsx scripts/stack/src/stack.ts build",
    "dev": "tsx scripts/stack/src/dev.ts",
    "check:hosts": "tsx scripts/stack/src/check-hosts.ts",
    "test:stack": "pnpm --filter @pf/stack run test:stack",
    "contract:breaking": "pnpm --filter @pf/contract-checks run breaking",
    "traceability:check": "pnpm --filter @pf/traceability run check",
    "traceability:matrix": "pnpm --filter @pf/traceability run matrix",
    "traceability:regression": "pnpm --filter @pf/traceability run regression"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.14.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@pf/eslint-config": "workspace:*",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "catalog:",
    "turbo": "2.11.6",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.0"
  }
}
